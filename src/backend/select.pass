# Instruction selection: choose a rule for every node that must be computed,
# then emit the rules' instructions block by block.
pass in unit
use cfg as cfg
use mach as mach
use lower as lower
import target as isa
import abi as abi

fn choose(n: Node) {
  let rule = lower.select(n)
  if rule == 0 {
    print("no rule computes {} (node {})", n.name, n)
    panic("instruction selection failed")
  }
  n.tile = rule
  lower.mark(n, rule)
  if n is PHI or n is CALL or n is SWITCH or n is TAILCALL { for i in 1..n.arity { mach.need(n.in(i)) } }
}

# An argument's value into register `d`. The convention wants an integer
# narrower than 32 bits carried up to 32 by its own kind of extension.
fn widened(d: Int, n: Node) {
  if n.float or n.bits >= 32 { copy(d, n) } else { lower.move(d, lower.extended(n, 2)) }
}

# A value arriving in machine register `r`, a parameter or a call's result.
# A boolean is kept as exactly 0 or 1, whatever the other side left above it.
fn arrive(n: Node, r: Int) {
  if n.float { lower.move-float(int(n), r) }
  else if n.bits == 1 { lower.zero-extend(int(n), r, 1) }
  else { lower.move(int(n), r) }
}

# A call: arguments to where the convention wants them, the call, the result
# out of its register. Integers and floating values each take their own
# registers in order, and whatever does not fit goes to the stack in order.
# The call reads the argument registers and may write every register the
# convention does not preserve.
fn call(n: Node) {
  var passed = word(0)
  var ints = 0
  var floats = 0
  var stacked = 0
  for i in 2..n.arity {
    let a = n.in(i)
    let r = if a.float then abi.float-arg(floats) else abi.int-arg(ints)
    if a.float { floats = floats + 1 } else { ints = ints + 1 }
    if r >= 0 {
      widened(0 - r - 1, a)
      passed = set-bit(passed, r)
    } else {
      if a.float { lower.to-frame-float(lower.operand(a), stacked) }
      else { lower.to-frame(lower.extended(a, 2), stacked) }
      stacked = stacked + 1
      out-slots = max(out-slots, stacked)
    }
  }
  # Something in the same image is called where it is; anything else through a register.
  if n.in(1) is SYMBOL { lower.call-symbol(int(n.in(1).payload)) }
  else { lower.call-register(lower.operand(n.in(1))) }
  mach.implicit(passed, if abi.LINK >= 0 then set-bit(isa.CALLER-SAVED, abi.LINK) else isa.CALLER-SAVED)
  calls = true
  let result = first u in users(n): u is RESULT and u.needed
  if result != none { arrive(result, 0 - (if result.float then abi.FLOAT-RESULT else abi.RESULT) - 1) }
}

# A tail call: arguments as for a call, all in registers, then out of this
# function straight into the other. The target waits in a register the
# function's exit does not touch.
fn tail-call(n: Node) {
  var passed = word(0)
  var ints = 0
  var floats = 0
  for i in 2..n.arity {
    let a = n.in(i)
    let r = if a.float then abi.float-arg(floats) else abi.int-arg(ints)
    if a.float { floats = floats + 1 } else { ints = ints + 1 }
    if r < 0 { panic("a tail call's arguments must all fit in registers") }
    widened(0 - r - 1, a)
    passed = set-bit(passed, r)
  }
  if n.in(1) is SYMBOL {
    lower.tail-symbol(int(n.in(1).payload))
    mach.implicit(passed, word(0))
  } else {
    lower.move(0 - isa.SCRATCH0 - 1, lower.operand(n.in(1)))
    lower.tail-register(0 - isa.SCRATCH0 - 1)
    mach.implicit(passed, word(0))
  }
}

# A switch: its value against each case in turn, then the default.
fn switch(n: Node) {
  let v = n.in(1)
  let w = if v.bits == 64 then 1 else 0
  for u in users(n) {
    if u is CASE { lower.branch-if-equal(w, lower.extended(v, 0), int(u.payload), int(u.block-of)) }
  }
  let otherwise = first u in users(n): u is DEFAULT
  lower.jump(int(otherwise.block-of))
}

# A parameter: out of its register, or out of the caller's frame. Where it
# arrives depends on the parameters before it.
fn param(n: Node) {
  let k = int(n.payload)
  var ints = 0
  var floats = 0
  var stacked = 0
  for j in 0..k {
    if float-type?(param-type(j)) {
      if abi.float-arg(floats) < 0 { stacked = stacked + 1 }
      floats = floats + 1
    } else {
      if abi.int-arg(ints) < 0 { stacked = stacked + 1 }
      ints = ints + 1
    }
  }
  let r = if n.float then abi.float-arg(floats) else abi.int-arg(ints)
  if r >= 0 {
    arrive(n, 0 - r - 1)
  } else {
    if n.float { lower.from-frame-float(int(n), stacked) } else { lower.from-frame(int(n), stacked) }
    mach.from-caller(int(n), stacked)
  }
}

fn phi-of?(u: Node, h: Node) -> Bool = u is PHI and u.in(0) == h

# `n`'s value into register `d`: computed straight into it if `n` is computed
# per block, copied otherwise.
fn copy(d: Int, n: Node) {
  if lower.local?(n) { lower.emit(n, n.tile, d) } else { transfer(d, lower.operand(n), n) }
}

# Register `s` into register `d`; both hold a value of `like`'s kind.
fn transfer(d: Int, s: Int, like: Node) {
  if like.float { lower.move-float(d, s) } else { lower.move(d, s) }
}

# The moves that give a region's phis their values on the edge from `b`. Where
# one phi's value is another phi of the same region, every value is read
# before any phi is written.
fn phi-moves(b: Block, s: Block) {
  var k = 0
  var index = 0
  for p in s.preds {
    if p == b { k = index }
    index = index + 1
  }
  let h = s.head
  let cyclic = any u in users(h): phi-of?(u, h) and phi-of?(u.in(k + 1), h) and u.in(k + 1) != u
  if cyclic {
    var temps: [Int] = []
    for u in users(h) {
      if phi-of?(u, h) {
        let t = mach.fresh()
        temps.push(t)
        copy(t, u.in(k + 1))
      }
    }
    var j = 0
    for u in users(h) {
      if phi-of?(u, h) {
        transfer(int(u), temps[j], u)
        j = j + 1
      }
    }
  } else {
    for u in users(h) {
      if phi-of?(u, h) and u.in(k + 1) != u { copy(int(u), u.in(k + 1)) }
    }
  }
}

fn run() {
  next-vreg = Node.count
  for b in order {
    for n in b.seq { if cfg.control?(n) or n is PHI { mach.need(n) } }
  }
  while worklist.len > 0 { choose(worklist.pop()) }
  for b in order {
    b.first-inst = Inst.count + 1
    emitting = b
    for n in b.seq {
      if n is CALL { call(n) }
      else if n is SWITCH { switch(n) }
      else if n is TAILCALL { tail-call(n) }
      else if n is PARAM { if n.tile != 0 { param(n) } }
      else if n.tile != 0 and not lower.local?(n) { lower.emit(n, n.tile, int(n)) }
    }
    if not cfg.end?(b.last) {
      for s in b.succs {
        phi-moves(b, s)
        lower.jump(int(s))
      }
    }
    b.last-inst = Inst.count
  }
}
