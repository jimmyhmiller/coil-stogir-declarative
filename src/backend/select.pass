# Instruction selection: choose a rule for every node that must be computed,
# then emit the rules' instructions block by block.
pass in unit
use cfg as cfg
use mach as mach
use lower as lower
import target as isa
import abi as abi

fn choose(n: Node) {
  let rule = lower.select(n)
  if rule == 0 {
    print("no rule computes {} (node {})", n.name, n)
    panic("instruction selection failed")
  }
  n.tile = rule
  lower.mark(n, rule)
  if n is PHI or n is CALL or n is SWITCH or n is TAILCALL or n is RETURN or n is RESERVE {
    for i in 1..n.arity { mach.need(n.in(i)) }
  }
}

# An argument's value into register `d`. The convention wants an integer
# narrower than 32 bits carried up to 32 by its own kind of extension.
fn widened(d: Int, n: Node) {
  if n.float or n.bits >= 32 { copy(d, n) } else { lower.move(d, lower.extended(n, 2)) }
}

# A value arriving in machine register `r`, a parameter or a call's result.
# A boolean is kept as exactly 0 or 1, whatever the other side left above it.
fn arrive(n: Node, r: Int) {
  if n.float { lower.move-float(int(n), r) }
  else if n.bits == 1 { lower.zero-extend(int(n), r, 1) }
  else { lower.move(int(n), r) }
}

# Where the convention puts arguments, one after another: how many of each
# kind's registers are taken, how many bytes of stack, and how many arguments
# to come must follow the last one there.
state ints: Int
state floats: Int
state stack-bytes: Int
state following: Int
state placed-bytes: Int               # how many bytes the last argument takes on the stack

fn begin-placing() {
  ints = 0
  floats = 0
  stack-bytes = 0
  following = 0
}

# The next argument's place: a register, or -(n + 1) for n bytes above the
# stack pointer as the call is made. `how` is what its shape says of it.
fn place(type: Int, how: Word) -> Int {
  let with = int(how & word(255))
  # Pinned: the register is said outright.
  if has-bit(how, 11) { return with }
  if has-bit(how, 8) and abi.INDIRECT-RESULT >= 0 { return abi.INDIRECT-RESULT }
  let float = float-type?(id(type))
  let unnamed = has-bit(how, 9)
  if following > 0 { following = following - 1 }
  else if not (unnamed and abi.VARIADIC-ON-STACK) {
    if float and floats + with < abi.FLOAT-ARGS {
      floats = floats + 1
      return abi.float-arg(floats - 1)
    }
    if not float and ints + with < abi.INT-ARGS {
      ints = ints + 1
      return abi.int-arg(ints - 1)
    }
    following = with
    if abi.REGISTERS-CLOSE { if float { floats = abi.FLOAT-ARGS } else { ints = abi.INT-ARGS } }
  }
  # A floating value is written as wide as it is; an integer fills its place.
  let bytes = type-bytes(id(type))
  let slot = if abi.STACK-PACKED and not unnamed then bytes else max(bytes, 8)
  placed-bytes = if float then bytes else slot
  let align = if has-bit(how, 10) then 16 else slot
  let at = (stack-bytes + align - 1) / align * align
  stack-bytes = at + slot
  0 - at - 1
}

# The arguments of call `n` to where its shape and the convention want them;
# the registers that took any.
fn pass-arguments(n: Node, on-stack: Bool) -> Word {
  var passed = word(0)
  let shape = int(n.payload)
  begin-placing()
  for i in 2..n.arity {
    let a = n.in(i)
    let at = place(int(a.type), shape-passing(shape, i - 2))
    if at >= 0 {
      widened(0 - at - 1, a)
      passed = set-bit(passed, at)
    } else {
      if not on-stack { panic("a tail call's arguments must all fit in registers") }
      if a.float { lower.to-stack-float(lower.operand(a), 0 - at - 1, placed-bytes) }
      else { lower.to-stack(lower.extended(a, 2), 0 - at - 1, placed-bytes) }
    }
  }
  out-slots = max(out-slots, (stack-bytes + 7) / 8)
  # Where the convention wants it, the number of floating registers used.
  if shape-variadic(shape) and abi.VARIADIC-COUNT >= 0 {
    lower.count-into(0 - abi.VARIADIC-COUNT - 1, min(floats, abi.FLOAT-ARGS))
    passed = set-bit(passed, abi.VARIADIC-COUNT)
  }
  passed
}

# A call: arguments to where the convention wants them, the call, the results
# out of their registers. The call reads the argument registers and may write
# every register the convention does not preserve.
fn call(n: Node) {
  if shape-pinned(int(n.payload)) {
    pinned-call(n)
    return
  }
  let passed = pass-arguments(n, true)
  # Something in the same image is called where it is; anything else through a register.
  if n.in(1) is SYMBOL { lower.call-symbol(int(n.in(1).payload)) }
  else { lower.call-register(lower.operand(n.in(1))) }
  mach.implicit(passed, if abi.LINK >= 0 then set-bit(isa.CALLER-SAVED, abi.LINK) else isa.CALLER-SAVED)
  calls = true
  for u in users(n) {
    if u is RESULT and u.needed {
      let r = if u.float then abi.float-result(int(u.payload)) else abi.int-result(int(u.payload))
      if r < 0 { panic("a call's result is numbered past the convention's result registers") }
      arrive(u, 0 - r - 1)
    }
  }
}

# A call that follows no convention: its arguments in the registers its shape
# pins them to, then the call, or the machine code the shape carries in its
# place. It writes the registers its shape says, and its result is where the
# shape says.
fn pinned-call(n: Node) {
  let shape = int(n.payload)
  let passed = pass-arguments(n, true)
  let bytes = shape-code-bytes(shape)
  var writes = shape-clobbers(shape)
  if bytes > 0 {
    var at = 0
    while at < bytes {
      var piece = 0
      for k in 0..isa.CODE-UNIT { piece = piece | (shape-code-byte(shape, at + k) << (8 * k)) }
      lower.machine-code(piece)
      at = at + isa.CODE-UNIT
    }
  } else {
    if n.in(1) is SYMBOL { lower.call-symbol(int(n.in(1).payload)) }
    else { lower.call-register(lower.operand(n.in(1))) }
    if abi.LINK >= 0 { writes = set-bit(writes, abi.LINK) }
  }
  let to = shape-result(shape)
  if to >= 0 { writes = set-bit(writes, to) }
  mach.implicit(passed, writes)
  pinned-writes = pinned-writes | writes
  calls = true
  for u in users(n) {
    if u is RESULT and u.needed {
      if to < 0 { panic("a call that gives no result is asked for one") }
      arrive(u, 0 - to - 1)
    }
  }
}

# The end of the function: each value to the register the convention returns
# it in, then out.
fn returns(n: Node) {
  var given = word(0)
  var ints = 0
  var floats = 0
  for i in 1..n.arity {
    let a = n.in(i)
    let r = if a.float then abi.float-result(floats) else abi.int-result(ints)
    if a.float { floats = floats + 1 } else { ints = ints + 1 }
    if r < 0 { panic("more values are returned than the convention has registers for") }
    widened(0 - r - 1, a)
    given = set-bit(given, r)
  }
  lower.leave()
  mach.implicit(given, word(0))
}

# A tail call: arguments as for a call, all in registers, then out of this
# function straight into the other. The target waits in a register the
# function's exit does not touch.
fn tail-call(n: Node) {
  let passed = pass-arguments(n, false)
  if n.in(1) is SYMBOL {
    lower.tail-symbol(int(n.in(1).payload))
    mach.implicit(passed, word(0))
  } else {
    lower.move(0 - isa.SCRATCH0 - 1, lower.operand(n.in(1)))
    lower.tail-register(0 - isa.SCRATCH0 - 1)
    mach.implicit(passed, word(0))
  }
}

# Memory sized as the function runs: the stack pointer goes down by the bytes
# asked for, and the memory is what is then just above the arguments for calls.
fn reserve(n: Node) {
  dynamic = true
  lower.reserve(lower.operand(n.in(1)))
  lower.above-arguments(int(n), 0)
  mach.above-arguments(int(n))
}

# A switch: its value against each case in turn, then the default.
fn switch(n: Node) {
  let v = n.in(1)
  let w = if v.bits == 64 then 1 else 0
  for u in users(n) {
    if u is CASE { lower.branch-if-equal(w, lower.extended(v, 0), int(u.payload), int(u.block-of)) }
  }
  let otherwise = first u in users(n): u is DEFAULT
  lower.jump(int(otherwise.block-of))
}

# A parameter: out of its register, or out of the caller's frame. Where it
# arrives depends on the parameters before it.
fn param(n: Node) {
  let k = int(n.payload)
  begin-placing()
  for j in 0..k { place(int(param-type(j)), param-passing(j)) }
  let at = place(int(n.type), param-passing(k))
  if at >= 0 {
    arrive(n, 0 - at - 1)
  } else {
    if n.float { lower.from-stack-float(int(n), 0 - abi.STACK - 1, 0 - at - 1, placed-bytes) }
    else { lower.from-stack(int(n), 0 - abi.STACK - 1, 0 - at - 1, placed-bytes) }
    mach.from-caller(int(n), 0 - at - 1, placed-bytes)
  }
}

fn phi-of?(u: Node, h: Node) -> Bool = u is PHI and u.in(0) == h

# `n`'s value into register `d`: computed straight into it if `n` is computed
# per block, copied otherwise.
fn copy(d: Int, n: Node) {
  if lower.local?(n) { lower.emit(n, n.tile, d) } else { transfer(d, lower.operand(n), n) }
}

# Register `s` into register `d`; both hold a value of `like`'s kind.
fn transfer(d: Int, s: Int, like: Node) {
  if like.float { lower.move-float(d, s) } else { lower.move(d, s) }
}

# The moves that give a region's phis their values on the edge from `b`. Where
# one phi's value is another phi of the same region, every value is read
# before any phi is written.
fn phi-moves(b: Block, s: Block) {
  var k = 0
  var index = 0
  for p in s.preds {
    if p == b { k = index }
    index = index + 1
  }
  let h = s.head
  let cyclic = any u in users(h): phi-of?(u, h) and phi-of?(u.in(k + 1), h) and u.in(k + 1) != u
  if cyclic {
    var temps: [Int] = []
    for u in users(h) {
      if phi-of?(u, h) {
        let t = mach.fresh-like(u)
        temps.push(t)
        copy(t, u.in(k + 1))
      }
    }
    var j = 0
    for u in users(h) {
      if phi-of?(u, h) {
        transfer(int(u), temps[j], u)
        j = j + 1
      }
    }
  } else {
    for u in users(h) {
      if phi-of?(u, h) and u.in(k + 1) != u { copy(int(u), u.in(k + 1)) }
    }
  }
}

fn run() {
  next-vreg = Node.count
  for b in order {
    for n in b.seq { if cfg.control?(n) or n is PHI { mach.need(n) } }
  }
  while worklist.len > 0 { choose(worklist.pop()) }
  for b in order {
    b.first-inst = Inst.count + 1
    emitting = b
    for n in b.seq {
      if n is CALL { call(n) }
      else if n is SWITCH { switch(n) }
      else if n is TAILCALL { tail-call(n) }
      else if n is RETURN { returns(n) }
      else if n is RESERVE { reserve(n) }
      else if n is PARAM { if n.tile != 0 { param(n) } }
      else if n.tile != 0 and not lower.local?(n) { lower.emit(n, n.tile, int(n)) }
    }
    if not cfg.end?(b.last) {
      for s in b.succs {
        phi-moves(b, s)
        lower.jump(int(s))
      }
    }
    b.last-inst = Inst.count
  }
}
