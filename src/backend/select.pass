# Instruction selection: choose a rule for every node that must be computed,
# then emit the rules' instructions block by block.
pass in backend.unit
use backend.cfg as cfg
use backend.mach as mach
use backend.a64-lower as lower
import backend.a64 as isa
import backend.a64-abi as abi

fn choose(n: Node) {
  let rule = lower.select(n)
  if rule == 0 {
    print("no rule computes {} (node {})", n.name, n)
    panic("instruction selection failed")
  }
  n.tile = rule
  lower.mark(n, rule)
  if n is PHI or n is CALL { for i in 1..n.arity { mach.need(n.in(i)) } }
}

# An argument's value into register `d`. The convention wants a value narrower
# than 32 bits carried up to 32 by its own kind of extension.
fn widened(d: Int, n: Node) {
  if n.bits >= 32 { copy(d, n) } else { lower.move(d, lower.extended(n, 2)) }
}

# A value arriving in machine register `r`, a parameter or a call's result.
# A boolean is kept as exactly 0 or 1, whatever the other side left above it.
fn arrive(n: Node, r: Int) {
  if n.bits == 1 { lower.zero-extend(int(n), r, 1) } else { lower.move(int(n), r) }
}

# A call: arguments to where the convention wants them, the call, the result
# out of its register. The call reads the argument registers and may write
# every register the convention does not preserve.
fn call(n: Node) {
  var passed = word(0)
  for i in 2..n.arity {
    let k = i - 2
    let r = abi.int-arg(k)
    if r >= 0 {
      widened(0 - r - 1, n.in(i))
      passed = set-bit(passed, r)
    } else {
      lower.to-frame(lower.extended(n.in(i), 2), k - abi.INT-ARGS)
      out-slots = max(out-slots, k - abi.INT-ARGS + 1)
    }
  }
  lower.call-register(lower.operand(n.in(1)))
  mach.implicit(passed, set-bit(isa.CALLER-SAVED, abi.LINK))
  calls = true
  let result = first u in users(n): u is RESULT and u.needed
  if result != none { arrive(result, 0 - abi.RESULT - 1) }
}

# A parameter: out of its register, or out of the caller's frame.
fn param(n: Node) {
  let k = int(n.payload)
  if abi.int-arg(k) >= 0 {
    arrive(n, 0 - abi.int-arg(k) - 1)
  } else {
    lower.from-frame(int(n), k - abi.INT-ARGS)
    mach.from-caller()
  }
}

fn phi-of?(u: Node, h: Node) -> Bool = u is PHI and u.in(0) == h

# `n`'s value into register `d`: computed straight into it if `n` is computed
# per block, copied otherwise.
fn copy(d: Int, n: Node) {
  if lower.local?(n) { lower.emit(n, n.tile, d) } else { lower.move(d, lower.operand(n)) }
}

# The moves that give a region's phis their values on the edge from `b`. Where
# one phi's value is another phi of the same region, every value is read
# before any phi is written.
fn phi-moves(b: Block, s: Block) {
  var k = 0
  var index = 0
  for p in s.preds {
    if p == b { k = index }
    index = index + 1
  }
  let h = s.head
  let cyclic = any u in users(h): phi-of?(u, h) and phi-of?(u.in(k + 1), h) and u.in(k + 1) != u
  if cyclic {
    var temps: [Int] = []
    for u in users(h) {
      if phi-of?(u, h) {
        let t = mach.fresh()
        temps.push(t)
        copy(t, u.in(k + 1))
      }
    }
    var j = 0
    for u in users(h) {
      if phi-of?(u, h) {
        lower.move(int(u), temps[j])
        j = j + 1
      }
    }
  } else {
    for u in users(h) {
      if phi-of?(u, h) and u.in(k + 1) != u { copy(int(u), u.in(k + 1)) }
    }
  }
}

fn run() {
  next-vreg = Node.count
  for b in order {
    for n in b.seq { if cfg.control?(n) or n is PHI { mach.need(n) } }
  }
  while worklist.len > 0 { choose(worklist.pop()) }
  for b in order {
    b.first-inst = Inst.count + 1
    emitting = b
    for n in b.seq {
      if n is CALL { call(n) }
      else if n is PARAM { if n.tile != 0 { param(n) } }
      else if n.tile != 0 and not lower.local?(n) { lower.emit(n, n.tile, int(n)) }
    }
    if not (b.last is IF) and not (b.last is RETURN) {
      for s in b.succs {
        phi-moves(b, s)
        lower.jump(int(s))
      }
    }
    b.last-inst = Inst.count
  }
}
