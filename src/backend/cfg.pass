# Blocks, from control nodes: who follows whom, dominators, loop depths.
pass in unit

entity Block
column head: Block -> Node            # the control node a block starts at
column last: Block -> Node            # the control node it ends at
column succs: Block -> [Block]
column preds: Block -> [Block]        # for a region, in the order of its inputs
column block-of: Node -> Block
column idom: Block -> Block
column dom-depth: Block -> Int
column loop-depth: Block -> Int
column rpo: Block -> Int
column seen: Block -> Bool
column mark: Block -> Int
column loop-blocks: Block -> [Block]  # for a loop's head: the head and its body
column loop-head: Block -> Block      # the head of the innermost loop a block is in
column loop-parent: Block -> Block    # for a loop's head: the head of the loop around it
state post: [Block]
state order: [Block]                  # reverse postorder from the entry
state stamp: Int
state root: Block                     # where control starts

fn head?(n: Node) -> Bool =
  n is START or n is REGION or n is LOOP or n is TRUE or n is FALSE or n is CASE or n is DEFAULT

# What a block ends with, when it does not just go on to a region.
fn end?(n: Node) -> Bool = n is IF or n is SWITCH or n is RETURN or n is TRAP or n is TAILCALL

# An update of memory, which is the value that was there.
fn update?(n: Node) -> Bool =
  n is SWAP or n is CAS or n is FETCH-ADD or n is FETCH-SUB or n is FETCH-AND or n is FETCH-NAND or n is FETCH-OR or
  n is FETCH-XOR or n is FETCH-SMAX or n is FETCH-SMIN or n is FETCH-UMAX or n is FETCH-UMIN

# In the control chain inside a block: it happens where it stands.
fn chain?(n: Node) -> Bool =
  n is CALL or n is LOAD or n is STORE or n is ATOMIC-LOAD or n is ATOMIC-STORE or n is FENCE or n is RESERVE or
  n is COPY or n is FILL or update?(n)

fn control?(n: Node) -> Bool = head?(n) or end?(n) or chain?(n)

# The control node that follows `c` inside its block, if any.
fn follower(c: Node) -> Node = first u in users(c): (chain?(u) or end?(u)) and u.in(0) == c

fn blocks() {
  for n in Node {
    if not n.dead and head?(n) {
      let b = Block.new()
      b.head = n
      n.block-of = b
    }
  }
  for b in Block {
    var c = b.head
    var next = follower(c)
    while next != none {
      next.block-of = b
      c = next
      next = if chain?(c) then follower(c) else none
    }
    b.last = c
  }
  for b in Block {
    let h = b.head
    if h is REGION or h is LOOP {
      for c in inputs(h) {
        b.preds.push(c.block-of)
        c.block-of.succs.push(b)
      }
    } else if h is TRUE or h is FALSE or h is CASE or h is DEFAULT {
      b.preds.push(h.in(0).block-of)
      h.in(0).block-of.succs.push(b)
    }
  }
}

fn visit(b: Block) {
  b.seen = true
  for s in b.succs { if not s.seen { visit(s) } }
  post.push(b)
}

fn ordering() {
  root = first b in Block: b.head is START
  visit(root)
  for i in reverse 0..post.len {
    post[i].rpo = order.len
    order.push(post[i])
  }
}

fn entry() -> Block = root

fn intersect(a: Block, b: Block) -> Block {
  var x = a
  var y = b
  while x != y {
    while x.rpo > y.rpo { x = x.idom }
    while y.rpo > x.rpo { y = y.idom }
  }
  x
}

# Cooper, Harvey and Kennedy's iteration over reverse postorder.
fn dominators() {
  let root = order[0]
  root.idom = root
  var changed = true
  while changed {
    changed = false
    for i in 1..order.len {
      let b = order[i]
      var best: Block = none
      for p in b.preds {
        if p.idom != none { best = if best == none then p else intersect(p, best) }
      }
      if b.idom != best {
        b.idom = best
        changed = true
      }
    }
  }
  for b in order { b.dom-depth = if b == root then 0 else b.idom.dom-depth + 1 }
}

fn dominates(a: Block, b: Block) -> Bool {
  var x = b
  while x.dom-depth > a.dom-depth { x = x.idom }
  x == a
}

# The nearest block that dominates both; `none` stands for "no block yet".
fn join(a: Block, b: Block) -> Block {
  if a == none { return b }
  if b == none { return a }
  var x = a
  var y = b
  while x.dom-depth > y.dom-depth { x = x.idom }
  while y.dom-depth > x.dom-depth { y = y.idom }
  while x != y {
    x = x.idom
    y = y.idom
  }
  x
}

# A loop is its head and everything that reaches a back edge without passing the
# head. Heads come outermost first, so the last loop to claim a block is its
# innermost.
fn loops() {
  for h in order {
    if h.head is LOOP {
      stamp = stamp + 1
      var work: [Block] = []
      h.mark = stamp
      h.loop-depth = h.loop-depth + 1
      h.loop-blocks.push(h)
      h.loop-parent = h.loop-head
      h.loop-head = h
      for p in h.preds {
        if dominates(h, p) and p.mark != stamp {
          p.mark = stamp
          work.push(p)
        }
      }
      while work.len > 0 {
        let b = work.pop()
        b.loop-depth = b.loop-depth + 1
        h.loop-blocks.push(b)
        b.loop-head = h
        for p in b.preds {
          if p.mark != stamp {
            p.mark = stamp
            work.push(p)
          }
        }
      }
    }
  }
}

fn build() {
  blocks()
  ordering()
  dominators()
  loops()
}
