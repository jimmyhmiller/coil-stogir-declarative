# What a compile is, as plans.
pipeline in backend.unit

# From a graph to code, with no optimization beyond what building the graph did.
plan quick {
  cfg.build
  schedule.build
  select.run
  alloc.run
  emit.run
}

# Simplify until nothing changes, solve the facts, simplify with them, compile.
# Then what the facts allow, and what that opens up.
plan default {
  until-stable { simplify.run }
  facts.solve
  until-stable { narrow.run  simplify.run }
  quick
}
