# Which AArch64 instructions compute each node.
lower in backend.unit
nodes backend.nodes
target backend.a64
emit backend.mach

# A constant is built again in each block that needs it in a register.
local CONST
local SLOT

# What the allocator and the emitter ask for by name.
template move(d, s)        = orr(1, d, zr, s)
template jump(to)          = b(to)
template from-frame(d, slot) = ldr(d, sp, slot)
template to-frame(s, slot)   = str(s, sp, slot)
# The stack pointer down and up by n bytes: n below 4096, or n pages of 4096.
template grow-stack(n)     = sub-imm(1, sp, sp, n)
template shrink-stack(n)   = add-imm(1, sp, sp, n)
template grow-pages(n)     = sub-imm-hi(1, sp, sp, n)
template shrink-pages(n)   = add-imm-hi(1, sp, sp, n)
template call-register(f)  = blr(f)

# A value narrower than 32 bits has no promise about the bits above it. These
# make a copy with those bits filled, for the instructions that read them.
template sign-extend(d, s, bits) = sbfm(0, d, s, 0, bits - 1)
template zero-extend(d, s, bits) = ubfm(0, d, s, 0, bits - 1)
# x29 to the frame record, n bytes (and pages) above the stack pointer.
template frame-record(n)   = add-imm(1, x29, sp, n)
template frame-pages(n)    = add-imm-hi(1, x29, x29, n)

# Control that is only structure.
rule START   => nothing
rule REGION  => nothing
rule LOOP    => nothing
rule TRUE    => nothing
rule FALSE   => nothing
rule PHI     => nothing
rule CALL    => nothing
rule RESULT  => nothing

rule PARAM   => nothing

# A frame object's address: so far below the frame record.
rule SLOT when object < 4096     => sub-imm(1, out, x29, object)
rule RETURN(_, v)                => orr(1, x0, zr, ex(v)) ; ret(x30)

# Constants, by how many sixteen-bit pieces they need.
rule CONST k when k >= 0 and k < 65536      => movz(1, out, k, 0)
rule CONST k when k < 0 and k >= -65536     => movn(1, out, ~k, 0)
rule CONST k when k >= 0 and k < 4294967296 => movz(1, out, k & 65535, 0) ; movk(1, out, (k >> 16) & 65535, 1)
rule CONST k when k >= 0 and k < 281474976710656 => movz(1, out, k & 65535, 0) ; movk(1, out, (k >> 16) & 65535, 1) ; movk(1, out, (k >> 32) & 65535, 2)
rule CONST k => movz(1, out, k & 65535, 0) ; movk(1, out, (k >> 16) & 65535, 1) ; movk(1, out, (k >> 32) & 65535, 2) ; movk(1, out, (k >> 48) & 65535, 3)

rule ADD(x, CONST k) when u12(k)   => add-imm(sf, out, x, k)
rule ADD(x, CONST k) when u12(-k)  => sub-imm(sf, out, x, -k)
rule ADD(once MUL(a, b), c)        => madd(sf, out, a, b, c)
rule ADD(x, y)                     => add(sf, out, x, y)
rule SUB(x, CONST k) when u12(k)   => sub-imm(sf, out, x, k)
rule SUB(x, y)                     => sub(sf, out, x, y)
rule MUL(x, y)                     => madd(sf, out, x, y, zr)
rule AND(x, y)                     => and(sf, out, x, y)
rule OR(x, y)                      => orr(sf, out, x, y)
rule XOR(x, y)                     => eor(sf, out, x, y)
rule NEG(x)                        => sub(sf, out, zr, x)
rule NOT(x) when width == 1        => movz(0, $one, 1, 0) ; eor(0, out, x, $one)
rule NOT(x)                        => orn(sf, out, zr, x)

# Shifts count modulo the width, which the machine does for 32 and 64 bits.
rule SHL(x, y) when width == 8     => ubfm(0, $n, y, 0, 2) ; lslv(0, out, x, $n)
rule SHL(x, y) when width == 16    => ubfm(0, $n, y, 0, 3) ; lslv(0, out, x, $n)
rule SHL(x, y)                     => lslv(sf, out, x, y)
rule SHR(x, y) when width == 8     => ubfm(0, $n, y, 0, 2) ; lsrv(0, out, zx(x), $n)
rule SHR(x, y) when width == 16    => ubfm(0, $n, y, 0, 3) ; lsrv(0, out, zx(x), $n)
rule SHR(x, y)                     => lsrv(sf, out, x, y)
rule SAR(x, y) when width == 8     => ubfm(0, $n, y, 0, 2) ; asrv(0, out, sx(x), $n)
rule SAR(x, y) when width == 16    => ubfm(0, $n, y, 0, 3) ; asrv(0, out, sx(x), $n)
rule SAR(x, y)                     => asrv(sf, out, x, y)

rule UDIV(x, y)                    => udiv(sf, out, zx(x), zx(y))
rule SDIV(x, y)                    => sdiv(sf, out, sx(x), sx(y))
rule UREM(x, y)                    => udiv(sf, $q, zx(x), zx(y)) ; msub(sf, out, $q, zx(y), zx(x))
rule SREM(x, y)                    => sdiv(sf, $q, sx(x), sx(y)) ; msub(sf, out, $q, sx(y), sx(x))

rule ZEXT(x)                       => ubfm(1, out, x, 0, bits(x) - 1)
rule SEXT(x)                       => sbfm(1, out, x, 0, bits(x) - 1)
rule TRUNC(x) when width == 1      => ubfm(0, out, x, 0, 0)
# Cutting a value down leaves it where it is: the bits above are nobody's.
rule TRUNC(x)                      => x

# Memory. An address that is a base plus a small multiple of the width is one
# instruction; any other address is computed first.
rule LOAD(_, ADD(p, CONST k)) when width == 64 and k >= 0 and k < 32768 and k & 7 == 0 => ldr(out, p, k >> 3)
rule LOAD(_, ADD(p, CONST k)) when width == 32 and k >= 0 and k < 16384 and k & 3 == 0 => ldrw(out, p, k >> 2)
rule LOAD(_, ADD(p, CONST k)) when width == 16 and k >= 0 and k < 8192 and k & 1 == 0  => ldrh(out, p, k >> 1)
rule LOAD(_, ADD(p, CONST k)) when width <= 8 and k >= 0 and k < 4096                 => ldrb(out, p, k)
rule LOAD(_, p) when width == 64   => ldr(out, p, 0)
rule LOAD(_, p) when width == 32   => ldrw(out, p, 0)
rule LOAD(_, p) when width == 16   => ldrh(out, p, 0)
rule LOAD(_, p)                    => ldrb(out, p, 0)
rule STORE(_, ADD(p, CONST k), v) when bits(v) == 64 and k >= 0 and k < 32768 and k & 7 == 0 => str(v, p, k >> 3)
rule STORE(_, ADD(p, CONST k), v) when bits(v) == 32 and k >= 0 and k < 16384 and k & 3 == 0 => strw(v, p, k >> 2)
rule STORE(_, ADD(p, CONST k), v) when bits(v) == 16 and k >= 0 and k < 8192 and k & 1 == 0  => strh(v, p, k >> 1)
rule STORE(_, ADD(p, CONST k), v) when bits(v) <= 8 and k >= 0 and k < 4096                 => strb(v, p, k)
rule STORE(_, p, v) when bits(v) == 64 => str(v, p, 0)
rule STORE(_, p, v) when bits(v) == 32 => strw(v, p, 0)
rule STORE(_, p, v) when bits(v) == 16 => strh(v, p, 0)
rule STORE(_, p, v)                    => strb(v, p, 0)

# One of two values: on a comparison's flags, or on a boolean in a register.
rule COND(EQ(a, b), x, y)   => subs(sf(a), zr, zx(a), zx(b)) ; csel(sf, out, x, y, eq)
rule COND(NE(a, b), x, y)   => subs(sf(a), zr, zx(a), zx(b)) ; csel(sf, out, x, y, ne)
rule COND(LT(a, b), x, y)   => subs(sf(a), zr, sx(a), sx(b)) ; csel(sf, out, x, y, lt)
rule COND(LE(a, b), x, y)   => subs(sf(a), zr, sx(a), sx(b)) ; csel(sf, out, x, y, le)
rule COND(ULT(a, b), x, y)  => subs(sf(a), zr, zx(a), zx(b)) ; csel(sf, out, x, y, lo)
rule COND(ULE(a, b), x, y)  => subs(sf(a), zr, zx(a), zx(b)) ; csel(sf, out, x, y, ls)
rule COND(c, x, y)          => subs-imm(0, zr, c, 0) ; csel(sf, out, x, y, ne)

# A comparison as a value: the flags, then 1 where the condition holds.
rule EQ(a, b)   => subs(sf(a), zr, zx(a), zx(b)) ; csinc(0, out, zr, zr, ne)
rule NE(a, b)   => subs(sf(a), zr, zx(a), zx(b)) ; csinc(0, out, zr, zr, eq)
rule LT(a, b)   => subs(sf(a), zr, sx(a), sx(b)) ; csinc(0, out, zr, zr, ge)
rule LE(a, b)   => subs(sf(a), zr, sx(a), sx(b)) ; csinc(0, out, zr, zr, gt)
rule ULT(a, b)  => subs(sf(a), zr, zx(a), zx(b)) ; csinc(0, out, zr, zr, hs)
rule ULE(a, b)  => subs(sf(a), zr, zx(a), zx(b)) ; csinc(0, out, zr, zr, hi)

# A branch on a comparison uses its flags directly.
rule IF(_, EQ(a, CONST k)) when k == 0  => cbz(sf(a), zx(a), then) ; b(else)
rule IF(_, NE(a, CONST k)) when k == 0  => cbnz(sf(a), zx(a), then) ; b(else)
rule IF(_, EQ(a, CONST k)) when u12(k)  => subs-imm(sf(a), zr, zx(a), k) ; b-cond(eq, then) ; b(else)
rule IF(_, NE(a, CONST k)) when u12(k)  => subs-imm(sf(a), zr, zx(a), k) ; b-cond(ne, then) ; b(else)
rule IF(_, LT(a, CONST k)) when u12(k)  => subs-imm(sf(a), zr, sx(a), k) ; b-cond(lt, then) ; b(else)
rule IF(_, LE(a, CONST k)) when u12(k)  => subs-imm(sf(a), zr, sx(a), k) ; b-cond(le, then) ; b(else)
rule IF(_, ULT(a, CONST k)) when u12(k) => subs-imm(sf(a), zr, zx(a), k) ; b-cond(lo, then) ; b(else)
rule IF(_, ULE(a, CONST k)) when u12(k) => subs-imm(sf(a), zr, zx(a), k) ; b-cond(ls, then) ; b(else)
rule IF(_, EQ(a, b))   => subs(sf(a), zr, zx(a), zx(b)) ; b-cond(eq, then) ; b(else)
rule IF(_, NE(a, b))   => subs(sf(a), zr, zx(a), zx(b)) ; b-cond(ne, then) ; b(else)
rule IF(_, LT(a, b))   => subs(sf(a), zr, sx(a), sx(b)) ; b-cond(lt, then) ; b(else)
rule IF(_, LE(a, b))   => subs(sf(a), zr, sx(a), sx(b)) ; b-cond(le, then) ; b(else)
rule IF(_, ULT(a, b))  => subs(sf(a), zr, zx(a), zx(b)) ; b-cond(lo, then) ; b(else)
rule IF(_, ULE(a, b))  => subs(sf(a), zr, zx(a), zx(b)) ; b-cond(ls, then) ; b(else)
rule IF(_, c)          => cbnz(0, c, then) ; b(else)
