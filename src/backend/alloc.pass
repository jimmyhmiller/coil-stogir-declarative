# Register allocation: linear scan over the instructions in layout order.
#
# A virtual register's interval runs from the first position where it is live
# to the last. Liveness is found one register at a time, walking back from each
# read to the blocks that write it, so it is exact for any block layout and
# needs no sets. A register is chosen where the interval starts and kept. When
# none is free, the live value that ends last moves to the frame for its whole
# life.
pass in backend.unit
use backend.cfg as cfg
use backend.mach as mach
import backend.a64 as isa

entity Vreg
column start: Vreg -> Int             # the first instruction that touches it, or 0
column end: Vreg -> Int               # the last
column reg: Vreg -> Int               # its register + 1, or 0
column slot: Vreg -> Int              # its frame slot + 1, or 0
column hint: Vreg -> Int              # an operand it is moved to or from, or 0
column reads: Vreg -> [Int]           # the instructions that read it
column writes: Vreg -> [Int]          # the instructions that write it
column home: Inst -> Block
column starting: Inst -> [Vreg]       # the registers whose intervals start here
column write-mark: Block -> Int       # the register last seen written in this block
column write-first: Block -> Int      # and where it is first written there
column live-mark: Block -> Int        # the register last found live into this block

# A machine register is busy from where an instruction writes it to where one
# reads it; `busy` holds those spans as from, to, from, to.
entity Phys
column busy: Phys -> [Int]
column written: Phys -> Int

state active: [Vreg]
state free: Word
state slots: Int
state used: Word                      # every register a value was given
state stack: [Block]

fn reg-kind?(kind: Int) -> Bool = kind == isa.K-DEF or kind == isa.K-USE or kind == isa.K-MOD

fn writes?(kind: Int) -> Bool = kind == isa.K-DEF or kind == isa.K-MOD

# `orr d, zr, s` is how a register is copied: its source, or 0.
fn move-source(i: Inst) -> Int =
  if i.inst-op == isa.ORR and i.a0 == 1 and i.a2 == 0 - isa.ZR - 1 then i.a3 else 0

fn touch(i: Inst, kind: Int, a: Int) {
  let at = int(i)
  if a > 0 {
    let v = id(a)
    if v.start == 0 { v.start = at }
    if at > v.end { v.end = at }
    if kind != isa.K-DEF { v.reads.push(at) }
    if writes?(kind) { v.writes.push(at) }
  } else if isa.in-set?(isa.ALLOCATABLE, 0 - a - 1) {
    let p = id(0 - a)
    if kind != isa.K-DEF {
      p.busy.push(p.written)
      p.busy.push(at)
    }
    if writes?(kind) { p.written = at }
  }
}

fn occurrences() {
  for n in 0..next-vreg { Vreg.new() }
  for r in 0..32 { Phys.new() }
  for b in order {
    for at in b.first-inst..b.last-inst + 1 {
      let i = id(at)
      let op = i.inst-op
      i.home = b
      for k in 0..isa.operand-count(op) {
        let kind = isa.operand-kind(op, k)
        if reg-kind?(kind) { touch(i, kind, mach.arg(i, k)) }
      }
      # Each side of a copy would like the other's register.
      let source = move-source(i)
      if source != 0 {
        let target = i.a1
        if target > 0 and id(target).hint == 0 { id(target).hint = source }
        if source > 0 and id(source).hint == 0 { id(source).hint = target }
      }
    }
  }
}

# `v` is needed at the top of `b`: it is live out of every block that comes
# before, and into each of those that does not write it.
fn live-into(v: Vreg, b: Block) {
  if b.live-mark == int(v) { return }
  b.live-mark = int(v)
  stack.push(b)
  while stack.len > 0 {
    let x = stack.pop()
    # Live before the block's first instruction reads anything.
    if x.first-inst - 1 < v.start { v.start = max(1, x.first-inst - 1) }
    for p in x.preds {
      if p.last-inst > v.end { v.end = p.last-inst }
      if p.write-mark != int(v) and p.live-mark != int(v) {
        p.live-mark = int(v)
        stack.push(p)
      }
    }
  }
}

fn intervals() {
  occurrences()
  for v in Vreg {
    if v.start != 0 {
      for w in v.writes {
        let b = id(w).home
        if b.write-mark != int(v) {
          b.write-mark = int(v)
          b.write-first = w
        }
      }
      for r in v.reads {
        let b = id(r).home
        if not (b.write-mark == int(v) and b.write-first < r) { live-into(v, b) }
      }
      id(min(v.start, Inst.count)).starting.push(v)
    }
  }
}

# Whether something fixed needs register `r` while `v` is live.
fn conflicts?(v: Vreg, r: Int) -> Bool {
  var from = 0
  var second = false
  for x in id(r + 1).busy {
    if second {
      if v.start < x and from < v.end { return true }
    } else {
      from = x
    }
    second = not second
  }
  false
}

fn usable?(v: Vreg, r: Int) -> Bool = has-bit(free, r) and not conflicts?(v, r)

# A free register for `v`, the one it is copied to or from if that one will do, or -1.
fn pick(v: Vreg) -> Int {
  let h = v.hint
  if h > 0 and id(h).reg != 0 and usable?(v, id(h).reg - 1) { return id(h).reg - 1 }
  if h < 0 and usable?(v, 0 - h - 1) { return 0 - h - 1 }
  var candidates = free
  while candidates != word(0) {
    let r = lowest-bit(candidates)
    if not conflicts?(v, r) { return r }
    candidates = clear-bit(candidates, r)
  }
  -1
}

fn spill(v: Vreg) {
  slots = slots + 1
  v.slot = slots
}

fn assign(v: Vreg) {
  let r = pick(v)
  if r >= 0 {
    v.reg = r + 1
    used = set-bit(used, r)
    free = clear-bit(free, r)
    active.push(v)
    return
  }
  var worst = v
  var index = -1
  for j in 0..active.len {
    let a = active[j]
    if a.end > worst.end and not conflicts?(v, a.reg - 1) {
      worst = a
      index = j
    }
  }
  if index >= 0 {
    v.reg = worst.reg
    worst.reg = 0
    active[index] = v
  }
  spill(worst)
}

# Registers of values that are read for the last time by now are free again.
fn expire(at: Int) {
  var kept = 0
  for j in 0..active.len {
    let v = active[j]
    if v.end <= at {
      free = set-bit(free, v.reg - 1)
    } else {
      active[kept] = v
      kept = kept + 1
    }
  }
  while active.len > kept { active.pop() }
}

fn scan() {
  free = isa.ALLOCATABLE
  for i in Inst {
    expire(int(i))
    for v in i.starting { assign(v) }
  }
}

fn run() {
  intervals()
  scan()
}
