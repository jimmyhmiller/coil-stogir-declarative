# A switch with many cases is taken apart by the middle of its values: first
# whether the value is below the middle, then a switch of the cases on that
# side, and so on down, so that finding one case of a hundred is seven
# comparisons and not a hundred.
pass in unit
use loops as loops
use cfg as cfg
import target as isa

state halved: Int

# How many cases a switch may have and still be compared with each in turn.
fn few() -> Int = 4

fn halve(s: Node) {
  var cases: [Node] = []
  for u in users(s) { if u is CASE { cases.push(u) } }
  if cases.len <= few() { return }
  # Cases that are many and close together are left whole, for a table, on a
  # machine that has them (as selection judges it).
  if isa.TABLES == 1 and cfg.on?(15) {
    var low = 4095
    var high = 0
    var fits = true
    for c in cases {
      if c.payload > word(4000) { fits = false } else {
        low = min(low, int(c.payload))
        high = max(high, int(c.payload))
      }
    }
    if fits and cases.len >= 5 and high - low < 3 * cases.len { return }
  }
  let otherwise = first u in users(s): u is DEFAULT
  if otherwise == none { return }
  # The middle: a case's value that half the cases are below.
  var middle: Node = none
  for c in cases {
    if middle == none and (count d in cases: d.payload < c.payload) == cases.len / 2 { middle = c }
  }
  if middle == none { return }
  let v = s.in(1)
  let test = ir.if!(mut graph, s.in(0), ir.ult!(mut graph, v, ir.make-const!(mut graph, v.type, middle.payload)))
  let below = ir.switch!(mut graph, ir.true!(mut graph, test), v)
  let above = ir.switch!(mut graph, ir.false!(mut graph, test), v)
  let at = middle.payload
  for c in cases { set-input(c, 0, if c.payload < at then below else above) }
  let both = ir.region!(mut graph, 2)
  set-input(both, 0, ir.default!(mut graph, below))
  set-input(both, 1, ir.default!(mut graph, above))
  grow-nodes()
  loops.follow(otherwise, both)
  drop(otherwise)
  drop(s)
  halved = halved + 1
  halve(below)
  halve(above)
}

fn run() {
  if not cfg.on?(5) { return }
  for n in Node { if not n.dead and n is SWITCH { halve(n) } }
}
