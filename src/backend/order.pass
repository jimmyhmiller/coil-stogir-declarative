# The order blocks are laid out in. A loop that tests at its top is laid out
# with the test at its bottom: the way round then falls into the test, which
# branches back, where it would have jumped to the test and branched out.
pass in unit
use cfg as cfg

column place: Block -> Int            # where a block is in the order

fn run() {
  for h in Block {
    if h.head is LOOP and h.succs.len == 2 and h.loop-blocks.len > 1 {
      for i in 0..order.len { order[i].place = i }
      let from = h.place
      var last = from
      for b in h.loop-blocks { last = max(last, b.place) }
      # The first block of all stays first: it is where the function is entered.
      if from > 0 and last > from {
        for k in from..last { order[k] = order[k + 1] }
        order[last] = h
      }
    }
  }
}
