# From chosen registers to bytes. Each operand is the register its value's
# piece has there. Where a value changes home, inside a block or along an edge,
# it is moved or brought back from the frame; a value that ever waits in the
# frame is stored there as it is written. Copies to the same register and jumps
# to the next block go away, the frame is opened and closed, and each
# instruction is encoded.
pass in unit
use mach as mach
use alloc as alloc
use lower as lower
import target as isa
import abi as abi

column final-first: Block -> Int      # a block's first final instruction
state final-start: Int                # final instructions follow the selected ones
state frame: Int                      # bytes of frame, a multiple of 16
state saved: Word                     # the registers the caller expects back unchanged
state move-to: [Int]                  # moves to make together: the registers written
state move-from: [Int]                # and read; -(slot + 1) for a value in the frame
state move-wide: [Bool]               # and whether what moves is sixteen bytes
column offset: Inst -> Int             # a final instruction's place in the code, in bytes
state code: [Byte]
state code-bytes: Int
state reloc-at: [Int]                  # the words that depend on a symbol's address,
state reloc-symbol: [Int]              # the symbol,
state reloc-op: [Int]                  # and the instruction there

fn marker(r: Int) -> Int = 0 - r - 1

# The piece that holds `v` at `pos`. Emission moves forward, so this never looks back.
fn here(v: Vreg, pos: Int) -> Piece {
  var p = v.at-piece
  if p == none { p = v.first-piece }
  while p.next-piece != none and pos >= p.pend { p = p.next-piece }
  v.at-piece = p
  p
}

# Operand `k` of `i`: for a virtual register, the machine register it is in there.
fn resolve(i: Inst, k: Int) -> Int {
  let op = i.inst-op
  if k >= isa.operand-count(op) { return 0 }
  let kind = isa.operand-kind(op, k)
  let a = mach.arg(i, k)
  if not alloc.reg-kind?(kind) or a < 0 { return a }
  let p = here(id(a), if kind == isa.K-DEF then 2 * int(i) + 1 else 2 * int(i))
  if p.reg == 0 { panic("emission: a value has no register where it is used") }
  marker(p.reg - 1)
}

# A register operand `a` as the machine register it is at `pos`.
fn placed(a: Int, pos: Int) -> Int = if a < 0 then a else marker(here(id(a), pos).reg - 1)

# The block an instruction jumps to: its label operand.
fn label-of(i: Inst) -> Int {
  let op = i.inst-op
  for k in 0..isa.operand-count(op) {
    if isa.operand-kind(op, k) == isa.K-LABEL { return mach.arg(i, k) }
  }
  0
}

# A value that waits in the frame anywhere is stored there wherever it is written.
fn finish(i: Inst, k: Int) {
  let op = i.inst-op
  if k < isa.operand-count(op) and alloc.writes?(isa.operand-kind(op, k)) {
    let a = mach.arg(i, k)
    if a > 0 and id(a).slot != 0 {
      keep(here(id(a), 2 * int(i) + 1).reg - 1, out-slots + id(a).slot - 1, id(a).wide)
    }
  }
}

# ---------------------------------------------------------------- moves made together

fn move(to: Int, from: Int, wide: Bool) {
  if to != from {
    move-to.push(to)
    move-from.push(from)
    move-wide.push(wide)
  }
}

fn floating?(r: Int) -> Bool = isa.reg-class(r) == 1

# The register the frame is found from: the stack pointer, unless the
# function moves that as it runs.
fn base() -> Int = marker(if dynamic then abi.BASE else abi.STACK)

# Register `r` to and from frame slot `at` above `from`, by the kind of
# register it is.
fn keep-at(r: Int, from: Int, at: Int) {
  if floating?(r) { lower.to-frame-float(marker(r), from, at) } else { lower.to-frame(marker(r), from, at) }
}

fn fetch-at(r: Int, from: Int, at: Int) {
  if floating?(r) { lower.from-frame-float(marker(r), from, at) } else { lower.from-frame(marker(r), from, at) }
}

# The same for a value's own slot: sixteen bytes if it is `wide`.
fn keep(r: Int, at: Int, wide: Bool) {
  if wide { lower.to-frame-wide(marker(r), base(), at) } else { keep-at(r, base(), at) }
}

fn fetch(r: Int, at: Int, wide: Bool) {
  if wide { lower.from-frame-wide(marker(r), base(), at) } else { fetch-at(r, base(), at) }
}

fn copy(to: Int, from: Int) {
  if floating?(to) { lower.move-float(marker(to), marker(from)) } else { lower.move(marker(to), marker(from)) }
}

fn emit-move(to: Int, from: Int, wide: Bool) {
  if from < 0 { fetch(to, out-slots + (0 - from) - 1, wide) } else { copy(to, from) }
}

# Every pending move, each source read before anything overwrites it. A ring
# of registers is opened by setting one of them aside in the scratch register.
fn flush-moves() {
  var left = move-to.len
  while left > 0 {
    var progress = false
    for j in 0..move-to.len {
      let d = move-to[j]
      if d >= 0 {
        let wanted = any k in 0..move-to.len: k != j and move-to[k] >= 0 and move-from[k] == d
        if not wanted {
          emit-move(d, move-from[j], move-wide[j])
          move-to[j] = -1
          left = left - 1
          progress = true
        }
      }
    }
    if not progress {
      var d = -1
      for j in 0..move-to.len { if d < 0 and move-to[j] >= 0 { d = move-to[j] } }
      let aside = if floating?(d) then isa.FSCRATCH else isa.SCRATCH0
      copy(aside, d)
      for j in 0..move-to.len { if move-to[j] >= 0 and move-from[j] == d { move-from[j] = aside } }
    }
  }
  move-to.clear()
  move-from.clear()
  move-wide.clear()
}

# A piece that starts inside a block takes its value from the piece before it.
fn transition(p: Piece) {
  let q = p.prev-piece
  if q == none or p.in-frame or p.reg == 0 { return }
  if q.in-frame or q.reg == 0 { move(p.reg - 1, 0 - p.owner.slot, p.owner.wide) }
  else { move(p.reg - 1, q.reg - 1, p.owner.wide) }
}

# The values live into `s`, from where they are at the end of `p` to where `s`
# expects them.
fn bring(p: Block, s: Block) {
  for v in s.live-in {
    # A value with one piece is in one place everywhere.
    if v.first-piece.next-piece != none {
      let to = alloc.piece-at(v, 2 * s.first-inst)
      let from = alloc.piece-at(v, 2 * p.last-inst + 1)
      if not to.in-frame and to.reg != 0 {
        if from.in-frame or from.reg == 0 { move(to.reg - 1, 0 - v.slot, v.wide) }
        else { move(to.reg - 1, from.reg - 1, v.wide) }
      }
    }
  }
  flush-moves()
}

fn rewrite(i: Inst, next: Int) {
  let op = i.inst-op
  let x0 = resolve(i, 0)
  let x1 = resolve(i, 1)
  let x2 = resolve(i, 2)
  let x3 = resolve(i, 3)
  let x4 = resolve(i, 4)
  let same-register = i.kind == 1 and placed(i.copy-to, 2 * int(i) + 1) == placed(i.copy-from, 2 * int(i))
  let falls-through = i.kind == 2 and label-of(i) == next
  if i.kind == 4 {
    # A parameter from the caller's frame, now that this frame's size is known.
    let d = placed(i.copy-to, 2 * int(i) + 1)
    let at = i.copy-from + frame + abi.RETURN-SLOTS * 8
    if floating?(0 - d - 1) { lower.from-stack-float(d, base(), at, i.caller-bytes) }
    else { lower.from-stack(d, base(), at, i.caller-bytes) }
  } else if i.kind == 5 {
    lower.above-arguments(placed(i.copy-to, 2 * int(i) + 1), out-slots * 8)
  } else if not same-register and not falls-through {
    if i.kind == 3 and frame > 0 { leave() }
    mach.emit(op, x0, x1, x2, x3, x4)
  }
  for k in 0..5 { finish(i, k) }
}

# Where a block's code starts, in bytes.
fn block-offset(b: Block) -> Int =
  if b.final-first > Inst.count then code-bytes else id(b.final-first).offset

# Operand `k` of a final instruction as its encoding wants it. A register is
# its number; a label the distance from the instruction, known once every
# instruction has its place; a symbol nothing yet.
fn encoded(i: Inst, k: Int, placed: Bool) -> Int {
  let op = i.inst-op
  if k >= isa.operand-count(op) { return 0 }
  let kind = isa.operand-kind(op, k)
  let a = mach.arg(i, k)
  if alloc.reg-kind?(kind) { return 0 - a - 1 }
  if kind == isa.K-LABEL { return if placed then block-offset(id(a)) - i.offset else 0 }
  if kind == isa.K-SYMBOL { return 0 }
  a
}

# The symbol a final instruction names, if any operand is one.
fn symbol-of(i: Inst) -> Int {
  let op = i.inst-op
  for k in 0..isa.operand-count(op) {
    if isa.operand-kind(op, k) == isa.K-SYMBOL { return mach.arg(i, k) }
  }
  0
}

# Every final instruction gets its place, then its bytes.
fn encode() {
  for at in final-start + 1..Inst.count + 1 {
    let i = id(at)
    i.offset = code-bytes
    code-bytes = code-bytes + isa.size(mut code, i.inst-op, encoded(i, 0, false), encoded(i, 1, false), encoded(i, 2, false), encoded(i, 3, false), encoded(i, 4, false))
  }
  for at in final-start + 1..Inst.count + 1 {
    let i = id(at)
    let field = isa.encode!(mut code, i.inst-op, encoded(i, 0, true), encoded(i, 1, true), encoded(i, 2, true), encoded(i, 3, true), encoded(i, 4, true))
    # A symbol's bits are filled in when the code is given addresses.
    if field >= 0 {
      reloc-at.push(i.offset + field)
      reloc-symbol.push(symbol-of(i))
      reloc-op.push(i.inst-op)
    }
  }
}

# The frame, from the stack pointer up: arguments for calls, values that have
# no register, the other registers the caller expects back, frame objects, and
# at the very top the frame record: the caller's frame register and, on
# machines with a link register, the return address, with the frame register
# pointing at it. On machines whose calls leave the return address on the
# stack, that is the word just above, so the record is the pair every unwinder
# expects either way. Frame objects end at the record, so each is a fixed
# distance below the frame register.
fn keeps-record?() -> Bool = has-bit(saved, abi.FRAME)

fn record-slots() -> Int = if not keeps-record?() then 0 else if abi.LINK >= 0 then 2 else 1

fn record-slot() -> Int = frame / 8 - record-slots()

# The saved registers that are not part of the frame record, and where they start.
fn others-saved() -> Word =
  if abi.LINK >= 0 then clear-bit(clear-bit(saved, abi.FRAME), abi.LINK) else clear-bit(saved, abi.FRAME)

fn others-slot() -> Int = record-slot() - object-bytes / 8 - bit-count(others-saved())

fn enter() {
  let sp = marker(abi.STACK)
  lower.grow-stack(frame)
  if keeps-record?() {
    lower.to-frame(marker(abi.FRAME), sp, record-slot())
    if abi.LINK >= 0 { lower.to-frame(marker(abi.LINK), sp, record-slot() + 1) }
    lower.frame-record(record-slot() * 8)
  }
  var rest = others-saved()
  var at = others-slot()
  while rest != word(0) {
    let r = lowest-bit(rest)
    keep-at(r, sp, at)
    at = at + 1
    rest = clear-bit(rest, r)
  }
  if dynamic { lower.base-from-stack(marker(abi.BASE)) }
}

fn leave() {
  let sp = marker(abi.STACK)
  # The stack pointer back to where the frame is, before anything is read from it.
  if dynamic { lower.stack-from-base(marker(abi.BASE)) }
  var rest = others-saved()
  var at = others-slot()
  while rest != word(0) {
    let r = lowest-bit(rest)
    fetch-at(r, sp, at)
    at = at + 1
    rest = clear-bit(rest, r)
  }
  if keeps-record?() {
    if abi.LINK >= 0 { lower.from-frame(marker(abi.LINK), sp, record-slot() + 1) }
    lower.from-frame(marker(abi.FRAME), sp, record-slot())
  }
  lower.shrink-stack(frame)
}

fn run() {
  saved = (used | pinned-writes) & isa.CALLEE-SAVED
  if dynamic { saved = set-bit(saved, abi.BASE) }
  if calls or object-bytes > 0 or dynamic {
    saved = set-bit(saved, abi.FRAME)
    if abi.LINK >= 0 { saved = set-bit(saved, abi.LINK) }
  }
  # With the return address a call left there, the stack is a multiple of 16,
  # and so is the frame record's place, below which frame objects are aligned.
  frame = ((out-slots + slots + bit-count(saved) + abi.RETURN-SLOTS) * 8 + object-bytes + 15) / 16 * 16 - abi.RETURN-SLOTS * 8
  final-start = Inst.count
  if frame > 0 { enter() }
  for index in 0..order.len {
    let b = order[index]
    let next = if index + 1 < order.len then int(order[index + 1]) else 0
    b.final-first = Inst.count + 1
    # A block with one way in, from a block with two ways out, takes its values here.
    if b.preds.len == 1 and b.preds[0].succs.len > 1 { bring(b.preds[0], b) }
    for at in b.first-inst..b.last-inst + 1 {
      let i = id(at)
      if at != b.first-inst {
        for p in i.starts-even { transition(p) }
        flush-moves()
      }
      # Before a block's closing jump, the values the next block expects.
      if at == b.last-inst and b.succs.len == 1 { bring(b, b.succs[0]) }
      rewrite(i, next)
    }
  }
  # The entry block's code starts at the frame's opening.
  order[0].final-first = final-start + 1
  encode()
}
