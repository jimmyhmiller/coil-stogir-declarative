# Machine code before registers are chosen: instructions in layout order, each
# with up to five operands. A register operand is a virtual register (a positive
# number: the node it holds, or a fresh one) or a machine register r, written
# -(r + 1). What each operand is comes from the target's description.
pass in backend.unit

entity Inst
column inst-op: Inst -> Int
column a0: Inst -> Int
column a1: Inst -> Int
column a2: Inst -> Int
column a3: Inst -> Int
column a4: Inst -> Int
column first-inst: Block -> Int       # a block's instructions are first..last
column last-inst: Block -> Int
column needed: Node -> Bool           # must be in a register
column tile: Node -> Int              # the rule that computes it, or 0
column local-reg: Node -> Int         # for a node computed per block: its register there
column local-block: Node -> Block
state emitting: Block                 # the block whose instructions are being emitted
state next-vreg: Int
state worklist: [Node]

fn emit(op: Int, a: Int, b: Int, c: Int, d: Int, e: Int) {
  let i = Inst.new()
  i.inst-op = op
  i.a0 = a
  i.a1 = b
  i.a2 = c
  i.a3 = d
  i.a4 = e
}

fn arg(i: Inst, k: Int) -> Int =
  if k == 0 then i.a0 else if k == 1 then i.a1 else if k == 2 then i.a2 else if k == 3 then i.a3 else i.a4

fn fresh() -> Int {
  next-vreg = next-vreg + 1
  next-vreg
}

fn need(n: Node) {
  if not n.needed {
    n.needed = true
    worklist.push(n)
  }
}

# The block an IF goes to when its condition holds (taken = 1) or does not.
fn target(n: Node, taken: Int) -> Int {
  let proj = first u in users(n): if taken == 1 then u is TRUE else u is FALSE
  int(proj.block-of)
}

# A node a rule may compute as part of its root: nothing else reads it, and it
# was not moved to a block that runs less often than the root's.
fn fusable(inner: Node, root: Node) -> Bool = inner.uses == 1 and inner.block-of == root.block-of

# The register a per-block node has in the block being emitted, or 0.
fn local(n: Node) -> Int = if n.local-block == emitting then n.local-reg else 0

fn set-local(n: Node, r: Int) {
  n.local-block = emitting
  n.local-reg = r
}

fn rule-of(n: Node) -> Int = n.tile
