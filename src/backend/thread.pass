# Ways that meet only to part again. Where several ways reach a region, each
# bringing a constant, and all that is done there is to branch on which
# constant came, each way goes straight to the side its constant chooses: the
# region, its phi and the branch are gone.
pass in unit

state threaded: Int

# Whether constant `k` sends branch condition `c` of phi `p` the true way.
fn chooses(c: Node, p: Node, k: Node) -> Bool {
  let set = k.payload != 0
  if c == p { return set }
  if c is EQ { return not set }
  set
}

# The condition `c` asks only whether phi `p` is zero or not.
fn asks?(c: Node, p: Node) -> Bool {
  if c == p { return p.bits == 1 }
  if not (c is NE or c is EQ) or c.uses != 1 { return false }
  (c.in(0) == p and c.in(1) is CONST and c.in(1).payload == 0) or
  (c.in(1) == p and c.in(0) is CONST and c.in(0).payload == 0)
}

# Where control goes on from the ways in `ways`: the one way, or their meeting.
fn onward(ways: [Node]) -> Node {
  if ways.len == 1 { return ways[0] }
  let region = ir.region!(mut graph, ways.len)
  for i in 0..ways.len { set-input(region, i, ways[i]) }
  grow-nodes()
  region
}

fn consider(branch: Node) {
  let r = branch.in(0)
  let c = branch.in(1)
  if not (r is REGION) or r.uses != 2 { return }
  let p = first u in users(r): u is PHI and u.in(0) == r
  if p == none or not asks?(c, p) { return }
  # The phi is read by the condition alone, or is the condition.
  if p.uses != 1 { return }
  for i in 1..p.arity { if not (p.in(i) is CONST) { return } }
  let yes = first u in users(branch): u is TRUE
  let no = first u in users(branch): u is FALSE
  if yes == none or no == none { return }
  var true-ways: [Node] = []
  var false-ways: [Node] = []
  for i in 1..p.arity {
    if chooses(c, p, p.in(i)) { true-ways.push(r.in(i - 1)) } else { false-ways.push(r.in(i - 1)) }
  }
  # With every way going to one side, the branch is one the rules fold.
  if true-ways.len == 0 or false-ways.len == 0 { return }
  replace-uses(yes, onward(true-ways))
  replace-uses(no, onward(false-ways))
  drop(yes)
  drop(no)
  drop(branch)
  if c != p { drop(c) }
  drop(p)
  drop(r)
  threaded = threaded + 1
}

fn run() {
  for n in Node { if not n.dead and n is IF { consider(n) } }
}
