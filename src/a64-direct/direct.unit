# The AArch64 compiler of -O0 and -O1, straight from CIR: registers chosen as
# the code is written, block by block.
unit
ops cir.ops
target a64.target
abi a64.abi
pass a64-direct.mach
templates a64-direct.lower
pass a64-direct.frames
pass a64-direct.regs
select a64-direct.select
pass a64-direct.walk
