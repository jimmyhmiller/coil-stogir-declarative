# The x86-64 compiler of -O0 and -O1, straight from CIR: registers chosen as
# the code is written, block by block.
unit
ops cir.ops
target x64.target
abi x64.abi
pass x64-direct.mach
templates x64-direct.lower
pass x64-direct.frames
pass x64-direct.regs
select x64-direct.select
pass x64-direct.walk
