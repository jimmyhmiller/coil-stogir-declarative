(module defbug.reader)
(import "coil.primitive" :as primitive)
(reader-provider "defbug.reader" read-it)
(def WORDS ["a" "b"])
(defn count-words [] (-> i64)
  (let [(mut n) 0] (for w WORDS (set! n (+ n (len w)))) n))
(defn read-it [(context Code)] (-> Code)
  (if (= (count-words) 2)
      (primitive/code-read "(defn answer [] (-> i64) 42)" `(reader-config))
      (primitive/code-read "(defn answer [] (-> i64) 0)" `(reader-config))))
