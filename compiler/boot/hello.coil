(module boot.hello)
(import "coil.alloc" :use [malloc-allocator])
(import "rt.graph" :as graph)
(import "backend.nodes" :as ir)
(import "backend.unit" :as st)
(import "backend.cfg" :as cfg)
(import "backend.schedule" :as schedule)

;;; sum(n) = 0 + 1 + … + (n - 1), plus a loop-invariant n * 3 that should leave the loop.
(defn main [] (-> i64)
  (let [(mut g) (graph/create (malloc-allocator))
        s (ir/start! (mut g))
        n (ir/param! (mut g) ir/T-I64 0)
        zero (ir/const! (mut g) ir/T-I64 0)
        one (ir/const! (mut g) ir/T-I64 1)
        loop (ir/loop! (mut g) 2)
        i (ir/phi! (mut g) ir/T-I64 loop 2)
        acc (ir/phi! (mut g) ir/T-I64 loop 2)
        test (ir/lt! (mut g) i n)
        branch (ir/if! (mut g) loop test)
        body (ir/true! (mut g) branch)
        exit (ir/false! (mut g) branch)
        k (ir/mul! (mut g) ir/T-I64 n (ir/const! (mut g) ir/T-I64 3))
        acc2 (ir/add! (mut g) ir/T-I64 (ir/add! (mut g) ir/T-I64 acc i) k)
        i2 (ir/add! (mut g) ir/T-I64 i one)
        r (ir/return! (mut g) exit acc)]
    (graph/set-input! (mut g) loop 0 s)
    (graph/set-input! (mut g) loop 1 body)
    (graph/set-input! (mut g) i 1 zero)
    (graph/set-input! (mut g) i 2 i2)
    (graph/set-input! (mut g) acc 1 zero)
    (graph/set-input! (mut g) acc 2 acc2)
    (println "verify: '{}'" (ir/verify g))
    (let [(mut cx) (st/create g (malloc-allocator))]
      (st/begin! (mut cx))
      (cfg/build (mut cx))
      (schedule/build (mut cx))
      (schedule/dump (mut cx)))
    0))
