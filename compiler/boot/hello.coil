(module boot.hello)
(import "coil.alloc" :use [malloc-allocator])
(import "rt.graph" :as graph)
(import "backend.nodes" :as ir)
(defn main [] (-> i64)
  (let [(mut g) (graph/create (malloc-allocator))
        s (ir/start! (mut g))
        x (ir/param! (mut g) ir/T-I32 0)
        k (ir/const! (mut g) ir/T-I32 7)
        a (ir/add! (mut g) ir/T-I32 k x)
        b (ir/add! (mut g) ir/T-I32 x k)
        r (ir/return! (mut g) s a)]
    (println "{} {} {} same={} verify='{}'" (ir/name (graph/op g a)) (graph/input g a 0) (graph/input g a 1) (= a b) (ir/verify g))
    (println "eval 250+7 as u8 = {}" (ir/eval ir/ADD 8 8 250 7 0))
    (println "eval slt(-1, 1) i8 = {}" (ir/eval ir/LT 1 8 255 1 0))
    0))
