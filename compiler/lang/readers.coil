;;; Every language's reader, as one provider. Each language is a function from a
;;; file's text to the text of a Coil module, read back here.
(module lang.readers)
(import "coil.primitive" :as primitive)
(import "lang.text" :as t)
(import "lang.ir" :as ir)
(import "lang.pass" :as pass)
(import "lang.isa" :as isa)
(import "lang.lower" :as lower)
(import "lang.abi" :as abi)
(import "lang.rewrite" :as rewrite)
(import "lang.layout" :as layout)
(import "lang.pipeline" :as pipeline)

(reader-provider "lang.readers" read-any)

(defn read-any [(context Code)] (-> Code)
  (primitive/code-read (module-text context) `(reader-config)))

(defn module-text [(context Code)] (-> (slice u8))
  (let [path (t/path-of context)
        src (t/source-of context)]
    (cond (t/ends-with path ".ir") (ir/module-text src path)
          (t/ends-with path ".unit") (pass/unit-text context)
          (t/ends-with path ".pass") (pass/pass-text context)
          (t/ends-with path ".isa") (isa/module-text src path)
          (t/ends-with path ".lower") (lower/module-text context)
          (t/ends-with path ".abi") (abi/module-text context)
          (t/ends-with path ".rewrite") (rewrite/module-text context)
          (t/ends-with path ".layout") (layout/module-text context)
          (t/ends-with path ".pipeline") (pipeline/module-text context)
          :else (t/fail-at path 1 1 "no language reads a file with this extension"))))
