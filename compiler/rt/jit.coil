;;; Machine code made runnable in this process: mapped writable, filled, then
;;; made executable. Never writable and executable at once.
(module rt.jit)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.os" :as os)
(import "coil.arraylist" :use [ArrayList])

(extern rt.jit.mmap :as "mmap" :cc (cc/C) [(ptr u8) i64 i32 i32 i32 i64] (-> (ptr u8)))
(extern rt.jit.mprotect :as "mprotect" :cc (cc/C) [(ptr u8) i64 i32] (-> i32))
(extern rt.jit.munmap :as "munmap" :cc (cc/C) [(ptr u8) i64] (-> i32))
(extern rt.jit.pagesize :as "getpagesize" :cc (cc/C) [] (-> i32))

(os/os-pick
  (extern rt.jit.clear-cache :as "__clear_cache" :cc (cc/C) [(ptr u8) (ptr u8)] (-> void))
  (extern rt.jit.invalidate :as "sys_icache_invalidate" :cc (cc/C) [(ptr u8) i64] (-> void))
  (do))

(defstruct Mapped [(base (ptr u8)) (size i64)])

;;; 32-bit instruction words, little-endian, as runnable code. Panics if the
;;; system refuses the mapping.
(defn map-words [(words (ArrayList u64))] (-> Mapped)
  (let [length (* 4 (len words))
        page (cast i64 (rt.jit.pagesize))
        size (* (/ (+ (if (= length 0) 1 length) (- page 1)) page) page)
        base (rt.jit.mmap (primitive/cast (ptr u8) 0) size 3 (os/os-pick 0x22 0x1002 0) -1 0)]
    (when (= (primitive/cast i64 base) -1) (panic "cannot map memory for code"))
    (for i (range 0 (len words))
      (let [w (get words i)]
        (set! (index base (* i 4)) (primitive/cast u8 (& w 255)))
        (set! (index base (+ (* i 4) 1)) (primitive/cast u8 (& (>> w 8) 255)))
        (set! (index base (+ (* i 4) 2)) (primitive/cast u8 (& (>> w 16) 255)))
        (set! (index base (+ (* i 4) 3)) (primitive/cast u8 (& (>> w 24) 255)))))
    (when (!= (rt.jit.mprotect base size 5) 0) (panic "cannot make code executable"))
    (os/os-pick (rt.jit.clear-cache base (primitive/index base length))
                (rt.jit.invalidate base length)
                (do))
    (Mapped :base base :size size)))

(defn release! [(code Mapped)] (-> void)
  (rt.jit.munmap (.base code) (.size code))
  (do))
