;;; A sea of nodes, as storage: nodes with an operation, a type, a payload and
;;; ordered inputs, and the uses of every node kept as each edge is written.
;;; It names no operation. A node set written in `.ir` gives the numbers meaning.
;;;
;;; A node is a positive i32; 0 is "no node". An edge is an input slot: edge e of
;;; user U refers to definition D. The uses of D are a doubly linked list threaded
;;; through its edges, so writing or clearing an input costs the same few stores
;;; whether or not anything reads the uses afterwards.
(module rt.graph)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])

;;; What a node is to the graph's structure. A `.ir` file gives each node a role;
;;; a node with ROLE-PURE is a value computed from its inputs alone.
(const ROLE-PURE 0)
(const ROLE-START 1)
(const ROLE-RETURN 2)
(const ROLE-REGION 3)
(const ROLE-LOOP 4)
(const ROLE-IF 5)
(const ROLE-TRUE 6)
(const ROLE-FALSE 7)
(const ROLE-PHI 8)
(const ROLE-PARAM 9)
(const ROLE-CONST 10)
(const ROLE-CALL 11)
(const ROLE-RESULT 12)
(const ROLE-LOAD 13)
(const ROLE-STORE 14)

(defstruct Graph
  [(ops (ArrayList u16))
   (tys (ArrayList u8))
   (payload (ArrayList u64))
   (first-in (ArrayList i32))
   (n-in (ArrayList i32))
   (edges (ArrayList i32))
   (edge-user (ArrayList i32))
   (use-next (ArrayList i32))
   (use-prev (ArrayList i32))
   (use-head (ArrayList i32))
   (use-count (ArrayList i32))
   (table (ArrayList i32))
   (interned i64)
   (start i32)
   (alc (dyn Allocator))])

(defn create [(a (dyn Allocator))] (-> Graph)
  (let [(mut g) (Graph
                  :ops (ArrayList::new [u16] a)
                  :tys (ArrayList::new [u8] a)
                  :payload (ArrayList::new [u64] a)
                  :first-in (ArrayList::new [i32] a)
                  :n-in (ArrayList::new [i32] a)
                  :edges (ArrayList::new [i32] a)
                  :edge-user (ArrayList::new [i32] a)
                  :use-next (ArrayList::new [i32] a)
                  :use-prev (ArrayList::new [i32] a)
                  :use-head (ArrayList::new [i32] a)
                  :use-count (ArrayList::new [i32] a)
                  :table (ArrayList::new [i32] a)
                  :interned 0
                  :start 0
                  :alc a)]
    ; Node 0 is "no node".
    (push! (mut (.ops g)) 0)
    (push! (mut (.tys g)) 0)
    (push! (mut (.payload g)) 0)
    (push! (mut (.first-in g)) 0)
    (push! (mut (.n-in g)) 0)
    (push! (mut (.use-head g)) -1)
    (push! (mut (.use-count g)) 0)
    (for _ (range 0 1024) (push! (mut (.table g)) 0))
    g))

(defn release! [(g (mut Graph))] (-> void)
  (free! (mut (.ops g)))
  (free! (mut (.tys g)))
  (free! (mut (.payload g)))
  (free! (mut (.first-in g)))
  (free! (mut (.n-in g)))
  (free! (mut (.edges g)))
  (free! (mut (.edge-user g)))
  (free! (mut (.use-next g)))
  (free! (mut (.use-prev g)))
  (free! (mut (.use-head g)))
  (free! (mut (.use-count g)))
  (free! (mut (.table g))))

;;; One past the largest node: the size of a column over nodes.
(defn size [(g Graph)] (-> i64)
  (len (.ops g)))

(defn op [(g Graph) (n i32)] (-> i32) :inline (Always)
  (cast i32 (get (.ops g) (cast i64 n))))

(defn ty [(g Graph) (n i32)] (-> i32) :inline (Always)
  (cast i32 (get (.tys g) (cast i64 n))))

(defn payload [(g Graph) (n i32)] (-> u64) :inline (Always)
  (get (.payload g) (cast i64 n)))

(defn arity [(g Graph) (n i32)] (-> i64) :inline (Always)
  (cast i64 (get (.n-in g) (cast i64 n))))

(defn input [(g Graph) (n i32) (i i64)] (-> i32) :inline (Always)
  (get (.edges g) (+ (cast i64 (get (.first-in g) (cast i64 n))) i)))

(defn use-count [(g Graph) (n i32)] (-> i64) :inline (Always)
  (cast i64 (get (.use-count g) (cast i64 n))))

(defn dead? [(g Graph) (n i32)] (-> bool) :inline (Always)
  (= (get (.ops g) (cast i64 n)) 0))

;;; The first edge that uses `n`, or -1. Walk with `next-use`; `user` and
;;; `slot` say whose input an edge is.
(defn first-use [(g Graph) (n i32)] (-> i32) :inline (Always)
  (get (.use-head g) (cast i64 n)))

(defn next-use [(g Graph) (e i32)] (-> i32) :inline (Always)
  (get (.use-next g) (cast i64 e)))

(defn user [(g Graph) (e i32)] (-> i32) :inline (Always)
  (get (.edge-user g) (cast i64 e)))

(defn slot [(g Graph) (e i32)] (-> i64) :inline (Always)
  (- (cast i64 e) (cast i64 (get (.first-in g) (cast i64 (get (.edge-user g) (cast i64 e)))))))

(defn unlink! [(g (mut Graph)) (e i64)] (-> void)
  (let [d (get (.edges g) e)]
    (when (!= d 0)
      (let [next (get (.use-next g) e)
            prev (get (.use-prev g) e)]
        (if (< prev 0)
            (set! (mut (.use-head g)) (cast i64 d) next)
            (set! (mut (.use-next g)) (cast i64 prev) next))
        (when (>= next 0) (set! (mut (.use-prev g)) (cast i64 next) prev))
        (set! (mut (.use-count g)) (cast i64 d) (- (get (.use-count g) (cast i64 d)) 1))
        (set! (mut (.edges g)) e 0)))))

(defn link! [(g (mut Graph)) (e i64) (d i32)] (-> void)
  (when (!= d 0)
    (let [head (get (.use-head g) (cast i64 d))]
      (set! (mut (.edges g)) e d)
      (set! (mut (.use-next g)) e head)
      (set! (mut (.use-prev g)) e -1)
      (when (>= head 0) (set! (mut (.use-prev g)) (cast i64 head) (cast i32 e)))
      (set! (mut (.use-head g)) (cast i64 d) (cast i32 e))
      (set! (mut (.use-count g)) (cast i64 d) (+ (get (.use-count g) (cast i64 d)) 1)))))

;;; A new node with `count` empty inputs.
(defn node! [(g (mut Graph)) (operation i32) (type i32) (data u64) (count i64)] (-> i32)
  (let [n (cast i32 (len (.ops g)))
        first (len (.edges g))]
    (push! (mut (.ops g)) (cast u16 operation))
    (push! (mut (.tys g)) (cast u8 type))
    (push! (mut (.payload g)) data)
    (push! (mut (.first-in g)) (cast i32 first))
    (push! (mut (.n-in g)) (cast i32 count))
    (push! (mut (.use-head g)) -1)
    (push! (mut (.use-count g)) 0)
    (for _ (range 0 count)
      (push! (mut (.edges g)) 0)
      (push! (mut (.edge-user g)) n)
      (push! (mut (.use-next g)) -1)
      (push! (mut (.use-prev g)) -1))
    n))

(defn set-input! [(g (mut Graph)) (n i32) (i i64) (d i32)] (-> void)
  (let [e (+ (cast i64 (get (.first-in g) (cast i64 n))) i)]
    (unlink! (mut g) e)
    (link! (mut g) e d)))

;;; Every use of `old` becomes a use of `new`.
(defn replace-uses! [(g (mut Graph)) (old i32) (new i32)] (-> void)
  (let [(mut e) (get (.use-head g) (cast i64 old))]
    (while (>= e 0)
      (let [next (get (.use-next g) (cast i64 e))]
        (unlink! (mut g) (cast i64 e))
        (link! (mut g) (cast i64 e) new)
        (set! e next)))))

;;; Remove `n`, which nothing uses, and then each input it was the last use of,
;;; if `pure` (indexed by operation) says that input is a value of its inputs
;;; alone. Returns how many nodes went.
(defn kill! [(g (mut Graph)) (n i32) (pure (slice bool))] (-> i64)
  (let [(mut stack) (ArrayList::new [i32] (.alc g))
        (mut killed) 0]
    (push! (mut stack) n)
    (while (> (len stack) 0)
      (let [x (get stack (- (len stack) 1))]
        (pop! (mut stack))
        (when (and (not (dead? g x)) (= (use-count g x) 0))
          (let [first (cast i64 (get (.first-in g) (cast i64 x)))]
            (for i (range 0 (arity g x))
              (let [d (get (.edges g) (+ first i))]
                (when (!= d 0)
                  (unlink! (mut g) (+ first i))
                  (when (and (= (use-count g d) 0) (get pure (cast i64 (op g d))))
                    (push! (mut stack) d))))))
          (set! (mut (.ops g)) (cast i64 x) 0)
          (set! killed (+ killed 1)))))
    (free! (mut stack))
    killed))

;; ---------------------------------------------------------------- value numbering

(defn mix [(h u64) (v u64)] (-> u64) :inline (Always)
  (let [x (primitive/imul (^ h v) (: 0x9E3779B97F4A7C15 u64))]
    (^ x (>> x 29))))

(defn hash-node [(operation i32) (type i32) (data u64) (a i32) (b i32) (c i32)] (-> u64)
  (mix (mix (mix (mix (mix (cast u64 operation) (cast u64 type)) data) (cast u64 a))
            (cast u64 b))
       (cast u64 c)))

(defn same? [(g Graph) (n i32) (operation i32) (type i32) (data u64) (count i64)
             (a i32) (b i32) (c i32)] (-> bool)
  (and (= (op g n) operation)
       (= (ty g n) type)
       (= (payload g n) data)
       (= (arity g n) count)
       (or (< count 1) (= (input g n 0) a))
       (or (< count 2) (= (input g n 1) b))
       (or (< count 3) (= (input g n 2) c))))

(defn grow-table! [(g (mut Graph))] (-> void)
  (let [old (len (.table g))
        (mut bigger) (ArrayList::new [i32] (.alc g))
        mask (cast u64 (- (* old 2) 1))]
    (for _ (range 0 (* old 2)) (push! (mut bigger) 0))
    (for n (.table g)
      (when (and (!= n 0) (not (dead? g n)))
        (let [k (arity g n)
              h (hash-node (op g n) (ty g n) (payload g n)
                           (if (> k 0) (input g n 0) 0)
                           (if (> k 1) (input g n 1) 0)
                           (if (> k 2) (input g n 2) 0))
              (mut at) (cast i64 (& h mask))]
          (while (!= (get bigger at) 0) (set! at (cast i64 (& (cast u64 (+ at 1)) mask))))
          (set! (mut bigger) at n))))
    (free! (mut (.table g)))
    (set! (.table g) bigger)))

;;; The node with this operation, type, payload and up to three inputs: the one
;;; already in the graph, or a new one. Only for nodes that are values of their
;;; inputs alone. An entry whose node was since changed no longer matches and is
;;; passed over, so a stale table loses sharing and never correctness.
(defn intern! [(g (mut Graph)) (operation i32) (type i32) (data u64) (count i64)
               (a i32) (b i32) (c i32)] (-> i32)
  (when (> (* (.interned g) 2) (len (.table g))) (grow-table! (mut g)))
  (let [mask (cast u64 (- (len (.table g)) 1))
        (mut at) (cast i64 (& (hash-node operation type data a b c) mask))
        (mut found) (: 0 i32)]
    (while (and (= found 0) (!= (get (.table g) at) 0))
      (let [n (get (.table g) at)]
        (if (same? g n operation type data count a b c)
            (set! found n)
            (set! at (cast i64 (& (cast u64 (+ at 1)) mask))))))
    (when (= found 0)
      (let [n (node! (mut g) operation type data count)]
        (when (> count 0) (set-input! (mut g) n 0 a))
        (when (> count 1) (set-input! (mut g) n 1 b))
        (when (> count 2) (set-input! (mut g) n 2 c))
        (set! (mut (.table g)) at n)
        (set! (.interned g) (+ (.interned g) 1))
        (set! found n)))
    found))
