;;; Compiled code before it has addresses: instruction words, symbols by name,
;;; and the places whose words depend on where a symbol ends up. A JIT gives it
;;; addresses in memory; an object file writes it down for a linker.
(module rt.image)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])

;;; defined: the word a symbol's code starts at, or -1 for one from outside.
;;; A relocation is the word it changes, the symbol, and the instruction there.
(defstruct Image
  [(words (ArrayList u32))
   (names (ArrayList (slice u8)))
   (defined (ArrayList i64))
   (reloc-at (ArrayList i64))
   (reloc-symbol (ArrayList i64))
   (reloc-op (ArrayList i64))])

(defn create [(a (dyn Allocator))] (-> Image)
  (Image
    :words (ArrayList::new [u32] a)
    :names (ArrayList::new [(slice u8)] a)
    :defined (ArrayList::new [i64] a)
    :reloc-at (ArrayList::new [i64] a)
    :reloc-symbol (ArrayList::new [i64] a)
    :reloc-op (ArrayList::new [i64] a)))

;;; The symbol with this name: its number, the same every time it is asked for.
(defn symbol! [(im (mut Image)) (name (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for i (range 0 (len (.names im)))
      (when (and (< found 0) (= (get (.names im) i) name)) (set! found i)))
    (when (< found 0)
      (push! (mut (.names im)) name)
      (push! (mut (.defined im)) -1)
      (set! found (- (len (.names im)) 1)))
    found))

;;; A function's code, as the symbol `symbol`: `at`, `symbols` and `ops` are its
;;; relocations, counted in words from its start.
(defn add-function! [(im (mut Image)) (symbol i64) (code (ArrayList u64)) (at (ArrayList i64))
                     (symbols (ArrayList i64)) (ops (ArrayList i64))] (-> void)
  (let [base (len (.words im))]
    (set! (mut (.defined im)) symbol base)
    (for w code (push! (mut (.words im)) (cast u32 (& w (: 0xFFFFFFFF u64)))))
    (for i (range 0 (len at))
      (push! (mut (.reloc-at im)) (+ base (get at i)))
      (push! (mut (.reloc-symbol im)) (get symbols i))
      (push! (mut (.reloc-op im)) (get ops i)))))
