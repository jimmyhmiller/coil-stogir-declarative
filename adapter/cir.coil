;;; From the Coil compiler's CIR to the backend: one function's CIR becomes a
;;; graph, the graph is compiled, and its code and what it refers to go into
;;; the compiler's assembler.
;;;
;;; CIR's integers are all 64 bits, kept extended by whoever made them; here
;;; they are all of the node set's 64-bit address type, which arithmetic and
;;; memory both take. A 128-bit integer is two of them, the low half and the
;;; high. Blocks are walked from the entry in an order that has every block
;;; after the blocks that reach it going forward; a block several edges enter
;;; is a REGION, one that an edge comes back to is a LOOP whose first input is
;;; the way in, and a block one edge enters is just what follows that edge.
(module declarative.cir)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "coil.scratch" :as scratch)
(import "tpde.cir" :as cir)
(import "tpde.asm" :as asm)
(import "rt.graph" :as graph)
(import "backend.nodes" :as ir)
(import "declarative.target" :as target)
(target/machine-pick (import "a64.unit" :as st) (import "x64.unit" :as st))
(target/machine-pick (import "a64.plans" :as plans) (import "x64.plans" :as plans))
(target/machine-pick (import "a64.target" :as isa) (import "x64.target" :as isa))

(defn fail [(f (ptr cir/Func)) (what (slice u8))] (-> never)
  (panic "declarative backend: {}: {}" (.name f) what))

;;; The type every 64-bit integer has.
(const W ir/T-PTR)

(defstruct Adapter
  [(f (ptr cir/Func))
   (ta (ptr asm/Asm))
   (g graph/Graph)
   (a (dyn Allocator))
   ; A CIR value's node, the high half of a 128-bit one, and the comparison a
   ; 0-or-1 value is the answer to; 0 for none.
   (node (ArrayList i32))
   (high (ArrayList i32))
   (truth (ArrayList i32))
   ; Blocks, by CIR's numbers: where each is in the walk (0 not reached, 1
   ; being walked, 2 walked), its edges out (a run of `targets` and `backward`),
   ; how many edges enter going forward and coming back, how many of each are
   ; connected so far, and the nodes that stand for it.
   (seen (ArrayList u8))
   (first-out (ArrayList i32))
   (targets (ArrayList u32))
   (backward (ArrayList bool))
   (forward-in (ArrayList i32))
   (backward-in (ArrayList i32))
   (forward-done (ArrayList i32))
   (backward-done (ArrayList i32))
   (merge (ArrayList i32))   ; the REGION of the forward edges, if several
   (loop (ArrayList i32))    ; the LOOP, if any edge comes back
   (enters (ArrayList i32))  ; the control that enters a block one forward edge reaches
   ; For a phi of a block with both: its phi at the REGION, and that phi's high half.
   (before (ArrayList i32))
   (before-high (ArrayList i32))
   (order (ArrayList u32))
   ; The control the instruction being lowered follows.
   (c i32)
   (params i64)
   (ints i64)
   (floats i64)])

(defn i64-of [(x u32)] (-> i64) (cast i64 x))

(defn word [(s (mut Adapter)) (v u64)] (-> i32)
  (ir/const! (mut (.g s)) W v))

;; ---------------------------------------------------------------- the walk

;;; The blocks `b`'s last instruction can go to, one for each edge: a branch on
;;; a condition whose two ways are one block has one edge, and a switch has one
;;; for its default and one for each case.
(defn out-edges! [(s (mut Adapter)) (b u32)] (-> void)
  (let [f (.f s)
        term (cir/val f (.term (cir/blk f b)))
        op (cast i64 (.op term))
        blocks (- (.ntotal term) (.nops term))]
    (set! (mut (.first-out s)) (i64-of b) (cast i32 (len (.targets s))))
    (cond
      (= op cir/OP-CONDBR)
        (let [then (cir/operand f term (.nops term))
              else (cir/operand f term (+ (.nops term) (: 1 u32)))]
          (push! (mut (.targets s)) then)
          (push! (mut (.backward s)) false)
          (when (!= then else)
            (push! (mut (.targets s)) else)
            (push! (mut (.backward s)) false)))
      (or (= op cir/OP-BR) (= op cir/OP-SWITCH))
        (for i (range 0 (i64-of blocks))
          (push! (mut (.targets s)) (cir/operand f term (+ (.nops term) (cast u32 i))))
          (push! (mut (.backward s)) false))
      :else 0)))

;;; Depth first from the entry: each block's edges, which of them come back to
;;; a block still being walked, and the blocks in the reverse of the order they
;;; were finished. The walk keeps its own stack: a function can be deep.
(defn walk! [(s (mut Adapter))] (-> void)
  (let [f (.f s)
        count (i64-of (cir/block-count f))
        (mut stack) (ArrayList::new [u32] (.a s))
        (mut at) (ArrayList::new [i64] (.a s))
        (mut post) (ArrayList::new [u32] (.a s))]
    ; `first-out` holds each block's first edge, and after those each block's
    ; one past its last.
    (for _ (range 0 (* count 2)) (push! (mut (.first-out s)) 0))
    (push! (mut stack) 0)
    (push! (mut at) 0)
    (set! (mut (.seen s)) 0 1)
    (out-edges! (mut s) 0)
    (set! (mut (.first-out s)) count (cast i32 (len (.targets s))))
    (while (> (len stack) 0)
      (let [b (get stack (- (len stack) 1))
            k (get at (- (len at) 1))
            from (cast i64 (get (.first-out s) (i64-of b)))
            to (cast i64 (get (.first-out s) (+ count (i64-of b))))]
        (if (< (+ from k) to)
            (let [t (get (.targets s) (+ from k))
                  state (get (.seen s) (i64-of t))]
              (set! (mut at) (- (len at) 1) (+ k 1))
              (cond
                (= state 0)
                  (do (set! (mut (.seen s)) (i64-of t) 1)
                      (out-edges! (mut s) t)
                      (set! (mut (.first-out s)) (+ count (i64-of t)) (cast i32 (len (.targets s))))
                      (set! (mut (.forward-in s)) (i64-of t) (+ (get (.forward-in s) (i64-of t)) 1))
                      (push! (mut stack) t)
                      (push! (mut at) 0))
                (= state 1)
                  (do (set! (mut (.backward s)) (+ from k) true)
                      (set! (mut (.backward-in s)) (i64-of t) (+ (get (.backward-in s) (i64-of t)) 1)))
                :else (set! (mut (.forward-in s)) (i64-of t) (+ (get (.forward-in s) (i64-of t)) 1))))
            (do (set! (mut (.seen s)) (i64-of b) 2)
                (push! (mut post) b)
                (pop! (mut stack))
                (pop! (mut at))
                0))))
    (for i (range 0 (len post)) (push! (mut (.order s)) (get post (- (- (len post) 1) i))))))

;; ---------------------------------------------------------------- types and values

(defn type-of [(s (mut Adapter)) (ty i64)] (-> i32)
  (cond (= ty cir/T-I64) W
        (= ty cir/T-I128) W
        (= ty cir/T-F32) ir/T-F32
        (= ty cir/T-F64) ir/T-F64
        :else (fail (.f s) "a 128-bit vector, which the backend does not have yet")))

(defn wide? [(s (mut Adapter)) (v u32)] (-> bool)
  (= (cast i64 (.ty (cir/val (.f s) v))) cir/T-I128))

;;; The integer type `bytes` wide, signed or not.
(defn narrow-type [(s (mut Adapter)) (bytes i64) (signed bool)] (-> i32)
  (cond (= bytes 1) (if signed ir/T-I8 ir/T-U8)
        (= bytes 2) (if signed ir/T-I16 ir/T-U16)
        (= bytes 4) (if signed ir/T-I32 ir/T-U32)
        (= bytes 8) W
        :else (fail (.f s) "an integer that is not 1, 2, 4 or 8 bytes")))

;;; A symbol's address: where it is, if this module defines it, or read from
;;; the table of addresses if it does not.
(defn symbol-address [(s (mut Adapter)) (symbol u32)] (-> i32)
  (if (= (.sect (asm/sym-at (.ta s) symbol)) -1)
      (ir/extern! (mut (.g s)) (cast u64 symbol))
      (ir/symbol! (mut (.g s)) (cast u64 symbol))))

;;; A parameter of the graph, the next one, passed as `how` says.
(defn next-param! [(s (mut Adapter)) (type i32) (how u64)] (-> i32)
  (let [index (.params s)]
    (set! (.params s) (+ index 1))
    (graph/declare-passing! (mut (.g s)) index how)
    (ir/param! (mut (.g s)) type (cast u64 index))))

;;; `v` carried from `bits` bits to all 64, by its sign or by zeros.
(defn extended [(s (mut Adapter)) (v i32) (bits i64) (signed bool)] (-> i32)
  (cond
    (>= bits 64) v
    (or (= bits 8) (= bits 16) (= bits 32))
      (let [low (ir/trunc! (mut (.g s)) (narrow-type (mut s) (/ bits 8) signed) v)]
        (if signed (ir/sext! (mut (.g s)) W low) (ir/zext! (mut (.g s)) W low)))
    :else
      (let [by (word (mut s) (cast u64 (- 64 bits)))
            up (ir/shl! (mut (.g s)) W v by)]
        (if signed (ir/sar! (mut (.g s)) W up by) (ir/shr! (mut (.g s)) W up by)))))

;;; Every parameter, in order: where each arrives depends on all before it.
(defn params! [(s (mut Adapter))] (-> void)
  (let [f (.f s)]
    (for i (range 0 (len (.args f)))
      (let [v (get (.args f) i)
            ty (cast i64 (.ty (cir/val f v)))
            flags (get (.arg-flags f) i)
            with (cast u64 (& (>> flags (: 16 u32)) (: 255 u32)))
            size (cast i64 (& (>> flags (: 24 u32)) (: 7 u32)))
            signed (!= (& flags (cast u32 cir/AF-SEXT)) (: 0 u32))]
        (cond
          (get (.arg-sret f) i)
            (set! (mut (.node s)) (i64-of v) (next-param! (mut s) W graph/PASS-INDIRECT))
          (= ty cir/T-I128)
            (do (set! (mut (.node s)) (i64-of v) (next-param! (mut s) W (| (: 1 u64) graph/PASS-ALIGN16)))
                (set! (mut (.high s)) (i64-of v) (next-param! (mut s) W 0)))
          ; An integer narrower than a word arrives with only its own bits
          ; promised; the flags say how many those are.
          (and (= ty cir/T-I64) (> size 0) (< (& (>> flags (: 16 u32)) (: 255 u32)) (: 1 u32)))
            (let [bytes (<< 1 (- size 1))
                  p (next-param! (mut s) (narrow-type (mut s) bytes signed) with)]
              (set! (mut (.node s)) (i64-of v)
                    (if signed (ir/sext! (mut (.g s)) W p) (ir/zext! (mut (.g s)) W p))))
          :else (set! (mut (.node s)) (i64-of v) (next-param! (mut s) (type-of (mut s) ty) with)))))))

;;; The node of CIR value `v`. A constant, a symbol's address and a frame
;;; object have no instruction: each is made where it is first used.
(defn value [(s (mut Adapter)) (v u32)] (-> i32)
  (let [have (get (.node s) (i64-of v))]
    (if (!= have 0)
        have
        (let [f (.f s)
              x (cir/val f v)
              op (cast i64 (.op x))
              ty (cast i64 (.ty x))
              made
                (cond
                  (= op cir/OP-CONST)
                    (cond (= ty cir/T-F32) (ir/const! (mut (.g s)) ir/T-F32 (& (cast u64 (.imm x)) (: 0xFFFFFFFF u64)))
                          (= ty cir/T-F64) (ir/const! (mut (.g s)) ir/T-F64 (cast u64 (.imm x)))
                          (= ty cir/T-I128)
                            (do (set! (mut (.high s)) (i64-of v) (word (mut s) (cast u64 (.imm2 x))))
                                (word (mut s) (cast u64 (.imm x))))
                          (= ty cir/T-I64) (word (mut s) (cast u64 (.imm x)))
                          :else (fail f "a constant 128-bit vector, which the backend does not have yet"))
                  (= op cir/OP-SYM)
                    (let [address (symbol-address (mut s) (cast u32 (.imm x)))]
                      (if (= (.imm2 x) 0)
                          address
                          (ir/add! (mut (.g s)) W address (word (mut s) (cast u64 (.imm2 x))))))
                  (= op cir/OP-ALLOCA)
                    ; An object's size is a whole number of its alignment, so
                    ; one aligned to 16 is larger than 8 bytes and is put at 16.
                    (let [align (.imm2 x)
                          size (* (/ (+ (.imm x) (- align 1)) align) align)]
                      (when (> align 16) (fail f "a frame object aligned to more than 16 bytes"))
                      (ir/slot! (mut (.g s)) (cast u64 size)))
                  :else (fail f "a value is used before the instruction that makes it"))]
          (set! (mut (.node s)) (i64-of v) made)
          made))))

;;; The high half of a 128-bit value.
(defn value-high [(s (mut Adapter)) (v u32)] (-> i32)
  (value (mut s) v)
  (let [have (get (.high s) (i64-of v))]
    (when (= have 0) (fail (.f s) "a 128-bit value has no high half"))
    have))

(defn define! [(s (mut Adapter)) (v u32) (n i32)] (-> void)
  (set! (mut (.node s)) (i64-of v) n))

(defn define-wide! [(s (mut Adapter)) (v u32) (low i32) (high i32)] (-> void)
  (set! (mut (.node s)) (i64-of v) low)
  (set! (mut (.high s)) (i64-of v) high))

;;; A 0-or-1 value from a condition, remembering the condition.
(defn define-truth! [(s (mut Adapter)) (v u32) (condition i32)] (-> void)
  (set! (mut (.truth s)) (i64-of v) condition)
  (define! (mut s) v (ir/zext! (mut (.g s)) W condition)))

;;; CIR value `v` as a condition: the one it was made from, or whether it is not 0.
(defn condition [(s (mut Adapter)) (v u32)] (-> i32)
  (let [n (value (mut s) v)
        made (get (.truth s) (i64-of v))]
    (if (!= made 0) made (ir/ne! (mut (.g s)) n (word (mut s) 0)))))

;; ---------------------------------------------------------------- blocks

(defn phi-at [(s (mut Adapter)) (b u32) (i i64)] (-> u32)
  (get (.phis (.f s)) (+ (i64-of (.phi-begin (cir/blk (.f s) b))) i)))

;;; The nodes that stand for each block more than one edge enters, and its phis.
(defn heads! [(s (mut Adapter))] (-> void)
  (let [f (.f s)]
    (for b (.order s)
      (let [at (i64-of b)
            forward (+ (cast i64 (get (.forward-in s) at)) (if (= at 0) 1 0))
            back (cast i64 (get (.backward-in s) at))
            phis (i64-of (.phi-count (cir/blk f b)))]
        (when (> forward 1)
          (let [region (ir/region! (mut (.g s)) forward)]
            (set! (mut (.merge s)) at region)
            (for i (range 0 phis)
              (let [p (phi-at (mut s) b i)
                    type (type-of (mut s) (cast i64 (.ty (cir/val f p))))]
                (set! (mut (.before s)) (i64-of p) (ir/phi! (mut (.g s)) type region forward))
                (when (wide? (mut s) p)
                  (set! (mut (.before-high s)) (i64-of p) (ir/phi! (mut (.g s)) type region forward)))))))
        (if (> back 0)
            (let [loop (ir/loop! (mut (.g s)) (+ back 1))
                  region (get (.merge s) at)]
              (set! (mut (.loop s)) at loop)
              (when (!= region 0) (graph/set-input! (mut (.g s)) loop 0 region))
              (for i (range 0 phis)
                (let [p (phi-at (mut s) b i)
                      type (type-of (mut s) (cast i64 (.ty (cir/val f p))))
                      low (ir/phi! (mut (.g s)) type loop (+ back 1))]
                  (when (!= region 0) (graph/set-input! (mut (.g s)) low 1 (get (.before s) (i64-of p))))
                  (set! (mut (.node s)) (i64-of p) low)
                  (when (wide? (mut s) p)
                    (let [high (ir/phi! (mut (.g s)) type loop (+ back 1))]
                      (when (!= region 0)
                        (graph/set-input! (mut (.g s)) high 1 (get (.before-high s) (i64-of p))))
                      (set! (mut (.high s)) (i64-of p) high))))))
            (for i (range 0 phis)
              (let [p (phi-at (mut s) b i)]
                (set! (mut (.node s)) (i64-of p) (get (.before s) (i64-of p)))
                (set! (mut (.high s)) (i64-of p) (get (.before-high s) (i64-of p))))))))))

;;; Which of phi `p`'s values comes from block `from`.
(defn incoming [(s (mut Adapter)) (p u32) (from u32)] (-> u32)
  (let [f (.f s)
        x (cir/val f p)]
    (block :found
      (for k (range 0 (i64-of (.nops x)))
        (when (= (cir/operand f x (+ (.nops x) (cast u32 k))) from)
          (return-from :found (cir/operand f x (cast u32 k)))))
      (fail f "a phi has no value for a block that reaches it"))))

;;; Edge `e`, out of block `from`, is taken from control `c`: the block it goes
;;; to follows `c`, and each of that block's phis takes its value for `from`.
(defn connect! [(s (mut Adapter)) (from u32) (e i64) (c i32)] (-> void)
  (let [f (.f s)
        to (get (.targets s) e)
        at (i64-of to)
        phis (i64-of (.phi-count (cir/blk f to)))
        region (get (.merge s) at)
        loop (get (.loop s) at)]
    (if (get (.backward s) e)
        (let [slot (+ 1 (cast i64 (get (.backward-done s) at)))]
          (set! (mut (.backward-done s)) at (cast i32 slot))
          (graph/set-input! (mut (.g s)) loop slot c)
          (for i (range 0 phis)
            (let [p (phi-at (mut s) to i)
                  v (incoming (mut s) p from)]
              (graph/set-input! (mut (.g s)) (get (.node s) (i64-of p)) (+ slot 1) (value (mut s) v))
              (when (wide? (mut s) p)
                (graph/set-input! (mut (.g s)) (get (.high s) (i64-of p)) (+ slot 1) (value-high (mut s) v))))))
        (let [slot (cast i64 (get (.forward-done s) at))]
          (set! (mut (.forward-done s)) at (cast i32 (+ slot 1)))
          (cond
            (!= region 0) (graph/set-input! (mut (.g s)) region slot c)
            (!= loop 0) (graph/set-input! (mut (.g s)) loop 0 c)
            :else (set! (mut (.enters s)) at c))
          (for i (range 0 phis)
            (let [p (phi-at (mut s) to i)
                  v (incoming (mut s) p from)
                  low (value (mut s) v)
                  high (if (wide? (mut s) p) (value-high (mut s) v) 0)]
              (cond
                (!= region 0)
                  (do (graph/set-input! (mut (.g s)) (get (.before s) (i64-of p)) (+ slot 1) low)
                      (when (!= high 0)
                        (graph/set-input! (mut (.g s)) (get (.before-high s) (i64-of p)) (+ slot 1) high)))
                (!= loop 0)
                  (do (graph/set-input! (mut (.g s)) (get (.node s) (i64-of p)) 1 low)
                      (when (!= high 0) (graph/set-input! (mut (.g s)) (get (.high s) (i64-of p)) 1 high)))
                ; A phi of a block one edge enters is the value that edge brings.
                :else
                  (do (set! (mut (.node s)) (i64-of p) low)
                      (set! (mut (.high s)) (i64-of p) high)
                      (set! (mut (.truth s)) (i64-of p) (get (.truth s) (i64-of v)))))))))))

;; ---------------------------------------------------------------- calls and returns

;;; How one argument of a call is passed, from CIR's flags for it.
(defn passing [(flags u32)] (-> u64)
  (let [with (cast u64 (& (>> flags (: 16 u32)) (: 255 u32)))]
    (| with
       (if (!= (& flags (cast u32 cir/AF-SRET)) (: 0 u32)) graph/PASS-INDIRECT (: 0 u64))
       (if (!= (& flags (cast u32 cir/AF-VARIADIC)) (: 0 u32)) graph/PASS-UNNAMED (: 0 u64)))))

;;; The arguments of call `v` as the graph passes them, into `values` and `how`:
;;; a 128-bit integer as two words that go in registers together, an integer
;;; the C function takes as a narrower one as that. Returns whether the
;;; function called takes any number of arguments.
(defn arguments! [(s (mut Adapter)) (v u32) (values (mut (ArrayList i32))) (how (mut (ArrayList u64)))] (-> bool)
  (let [f (.f s)
        x (cir/val f v)
        first (if (= (.imm x) -1) 1 0)
        (mut variadic) false]
    (for i (range first (i64-of (.nops x)))
      (let [a (cir/operand f x (cast u32 i))
            flags (get (.argflags f) (+ (i64-of (.opb x)) i))
            ty (cast i64 (.ty (cir/val f a)))
            size (cast i64 (& (>> flags (: 24 u32)) (: 7 u32)))
            unnamed (!= (& flags (cast u32 cir/AF-VARIADIC)) (: 0 u32))]
        (when (cir/af-byval? flags) (fail f "an argument copied onto the stack, which only System V has"))
        (when unnamed (set! variadic true))
        (cond
          (= ty cir/T-I128)
            (do (push! (mut values) (value (mut s) a))
                (push! (mut how) (| (: 1 u64) graph/PASS-ALIGN16 (if unnamed graph/PASS-UNNAMED (: 0 u64))))
                (push! (mut values) (value-high (mut s) a))
                (push! (mut how) (if unnamed graph/PASS-UNNAMED (: 0 u64))))
          (and (= ty cir/T-I64) (> size 0) (not unnamed))
            (do (push! (mut values)
                       (ir/trunc! (mut (.g s))
                                  (narrow-type (mut s) (<< 1 (- size 1)) (cir/af-signed? flags))
                                  (value (mut s) a)))
                (push! (mut how) (passing flags)))
          :else
            (do (push! (mut values) (value (mut s) a))
                (push! (mut how) (passing flags))))))
    variadic))

;;; The shape that says `how`, or 0 if there is nothing to say.
(defn shape-of [(s (mut Adapter)) (how (ArrayList u64)) (variadic bool)] (-> u64)
  (let [(mut plain) (not variadic)]
    (for h how (when (!= h 0) (set! plain false)))
    (if plain
        (: 0 u64)
        (let [shape (graph/shape! (mut (.g s)) variadic)]
          (for h how (graph/shape-arg! (mut (.g s)) shape h))
          shape))))

;;; What call `v` calls: a symbol, called where it is, or an address.
(defn callee [(s (mut Adapter)) (v u32)] (-> i32)
  (let [x (cir/val (.f s) v)]
    (if (= (.imm x) -1)
        (value (mut s) (cir/operand (.f s) x 0))
        (ir/symbol! (mut (.g s)) (cast u64 (.imm x))))))

;;; The next result of call node `call` of CIR type `ty`, for CIR value `v`:
;;; integers and floating values each count their own.
(defn result! [(s (mut Adapter)) (call i32) (v u32) (ty i64)] (-> void)
  (cond
    (= ty cir/T-I128)
      (do (define-wide! (mut s) v
                        (ir/result! (mut (.g s)) W (cast u64 (.ints s)) call)
                        (ir/result! (mut (.g s)) W (cast u64 (+ (.ints s) 1)) call))
          (set! (.ints s) (+ (.ints s) 2)))
    (or (= ty cir/T-F32) (= ty cir/T-F64))
      (do (define! (mut s) v (ir/result! (mut (.g s)) (type-of (mut s) ty) (cast u64 (.floats s)) call))
          (set! (.floats s) (+ (.floats s) 1)))
    :else
      (do (define! (mut s) v (ir/result! (mut (.g s)) (type-of (mut s) ty) (cast u64 (.ints s)) call))
          (set! (.ints s) (+ (.ints s) 1)))))

;;; Every result of CIR call `v`, which graph node `call` made.
(defn results! [(s (mut Adapter)) (v u32) (call i32)] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        count (cast i64 (.aux x))]
    (set! (.ints s) 0)
    (set! (.floats s) 0)
    (when (> count 0) (result! (mut s) call v (cast i64 (.ty x))))
    (for i (range 1 count)
      (let [r (+ v (cast u32 i))]
        (result! (mut s) call r (cast i64 (.ty (cir/val f r))))))))

(defn call! [(s (mut Adapter)) (v u32)] (-> void)
  (let [(mut values) (ArrayList::new [i32] (.a s))
        (mut how) (ArrayList::new [u64] (.a s))
        variadic (arguments! (mut s) v (mut values) (mut how))
        shape (shape-of (mut s) how variadic)
        call (ir/call-node! (mut (.g s)) shape (.c s) (callee (mut s) v) (len values))]
    (for i (range 0 (len values)) (graph/set-input! (mut (.g s)) call (+ i 2) (get values i)))
    (set! (.c s) call)
    (results! (mut s) v call)))

;;; The values a return gives back, in the order of their registers.
(defn return-values! [(s (mut Adapter)) (values (mut (ArrayList i32))) (v u32)] (-> void)
  (push! (mut values) (value (mut s) v))
  (when (wide? (mut s) v) (push! (mut values) (value-high (mut s) v))))

(defn return! [(s (mut Adapter)) (values (ArrayList i32))] (-> void)
  (let [r (ir/return! (mut (.g s)) (.c s) (len values))]
    (for i (range 0 (len values)) (graph/set-input! (mut (.g s)) r (+ i 1) (get values i)))))

;;; A call that ends the function with the called function's results. It goes
;;; straight there, this function's frame given back first, when every
;;; argument is in a register and none is an address into this frame; if not,
;;; it is a call and a return of what it returned.
(defn tail-call! [(s (mut Adapter)) (v u32)] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        (mut values) (ArrayList::new [i32] (.a s))
        (mut how) (ArrayList::new [u64] (.a s))
        variadic (arguments! (mut s) v (mut values) (mut how))
        (mut ints) 0
        (mut floats) 0
        (mut direct) (not variadic)]
    (for i (range 0 (len values))
      (let [h (get how i)
            float (ir/type-float? (graph/ty (.g s) (get values i)))]
        (when (!= (& h graph/PASS-INDIRECT) 0) (set! direct false))
        (if float (set! floats (+ floats 1)) (set! ints (+ ints 1)))
        (when (and (.frame-escapes f) (not float)) (set! direct false))))
    (when (or (> ints 8) (> floats 8)) (set! direct false))
    (if direct
        (let [call (ir/tailcall! (mut (.g s)) (if (> (cast i64 (.aux x)) 0) (type-of (mut s) (cast i64 (.ty x))) W)
                                 (shape-of (mut s) how false) (.c s) (callee (mut s) v) (len values))]
          (for i (range 0 (len values)) (graph/set-input! (mut (.g s)) call (+ i 2) (get values i))))
        (let [call (ir/call-node! (mut (.g s)) (shape-of (mut s) how variadic) (.c s) (callee (mut s) v) (len values))
              (mut back) (ArrayList::new [i32] (.a s))]
          (for i (range 0 (len values)) (graph/set-input! (mut (.g s)) call (+ i 2) (get values i)))
          (set! (.c s) call)
          (results! (mut s) v call)
          (for i (range 0 (cast i64 (.aux x))) (return-values! (mut s) (mut back) (+ v (cast u32 i))))
          (return! (mut s) back)))))

;; ---------------------------------------------------------------- the end of a block

(defn terminator! [(s (mut Adapter)) (b u32) (v u32)] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        op (cast i64 (.op x))
        first (cast i64 (get (.first-out s) (i64-of b)))]
    (cond
      (= op cir/OP-BR) (connect! (mut s) b first (.c s))
      (= op cir/OP-CONDBR)
        (if (= (cir/operand f x (.nops x)) (cir/operand f x (+ (.nops x) (: 1 u32))))
            (connect! (mut s) b first (.c s))
            (let [branch (ir/if! (mut (.g s)) (.c s) (condition (mut s) (cir/operand f x 0)))]
              (connect! (mut s) b first (ir/true! (mut (.g s)) branch))
              (connect! (mut s) b (+ first 1) (ir/false! (mut (.g s)) branch))))
      (= op cir/OP-SWITCH)
        (let [switch (ir/switch! (mut (.g s)) (.c s) (value (mut s) (cir/operand f x 0)))
              cases (- (i64-of (- (.ntotal x) (.nops x))) 1)]
          (connect! (mut s) b first (ir/default! (mut (.g s)) switch))
          (for i (range 0 cases)
            (connect! (mut s) b (+ first (+ i 1))
                      (ir/case! (mut (.g s)) (get (.case-values f) (+ (.imm x) i)) switch))))
      (= op cir/OP-RET)
        (let [(mut values) (ArrayList::new [i32] (.a s))]
          (for i (range 0 (i64-of (.nops x))) (return-values! (mut s) (mut values) (cir/operand f x (cast u32 i))))
          (return! (mut s) values))
      (= op cir/OP-UNREACHABLE) (do (ir/trap! (mut (.g s)) (.c s)) 0)
      (= op cir/OP-TAILCALL) (tail-call! (mut s) v)
      :else (fail f "a block does not end in a branch, a switch, a return or a trap"))))

;; ---------------------------------------------------------------- out

;;; The assembler's name for what an instruction of the backend's needs of a
;;; symbol's address.
(defn reloc-kind [(f (ptr cir/Func)) (op i64)] (-> i64)
  (let [name (isa/reloc-name (isa/reloc-of op))]
    (cond (= name "branch26") asm/R-BRANCH26
          (= name "page21") asm/R-PAGE21
          (= name "pageoff12") asm/R-PAGEOFF12
          (= name "got-page21") asm/R-GOT-PAGE21
          (= name "got-pageoff12") asm/R-GOT-PAGEOFF12
          (= name "plt32") asm/R-PLT32
          (= name "pc32") asm/R-PCREL32
          (= name "gotpcrel") asm/R-GOTPCREL32
          :else (fail f "the assembler has no relocation of this kind"))))

;;; Compiles the graph and puts its code in the assembler's text, as `symbol`.
(defn emit! [(s (mut Adapter)) (symbol u32) (level i32)] (-> void)
  (let [f (.f s)
        ta (.ta s)
        problem (if (> (cast i64 level) 8) (ir/verify (.g s)) "")
        (mut cx) (st/create (.g s) (.a s))]
    (when (!= problem "") (fail f problem))
    (st/begin! (mut cx))
    (set! (.copy-routine cx) (+ (cast i64 (asm/runtime-sym! ta "memcpy")) 1))
    (set! (.fill-routine cx) (+ (cast i64 (asm/runtime-sym! ta "memset")) 1))
    (if (< (cast i64 level) 2) (plans/quick (mut cx)) (plans/default (mut cx)))
    (let [code (.code cx)
          at (asm/sect-append! ta asm/SEC-TEXT (.data code) (len code) isa/ALIGN)]
      (for i (range 0 (len (.reloc-at cx)))
        (asm/reloc! ta asm/SEC-TEXT (+ at (get (.reloc-at cx) i)) (cast u32 (get (.reloc-symbol cx) i))
                    (reloc-kind f (get (.reloc-op cx) i)) 0))
      (asm/sym-def! ta symbol asm/SEC-TEXT at (len code)))))
